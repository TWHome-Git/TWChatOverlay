<Window x:Class="TWChatOverlay.Views.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Menu" SizeToContent="Height" Width="44" Background="{DynamicResource PrimaryBackgroundBrush}" Topmost="True" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="False" ShowInTaskbar="False">
    <Window.Resources>
        <sys:Double x:Key="MenuIconSize">36</sys:Double>
        <sys:Double x:Key="MenuButtonSize">36</sys:Double>
        <Style x:Key="MenuIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuButtonBorder" Property="Background" Value="{DynamicResource MenuButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MenuButtonBorder" Property="Background" Value="{DynamicResource MenuButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource PrimaryBackgroundBrush}">
        <StackPanel x:Name="RootPanel" Margin="2">
            <!-- 앱 아이콘: 항상 표시. 마우스를 올리면 아래 메뉴가 펼쳐지고, 잡고 끌면 이동 -->
            <Border x:Name="AppIconArea"
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="2"
                    CornerRadius="8"
                    Cursor="Hand"
                    ToolTip="메뉴 — 마우스를 올리면 펼쳐지고, 클릭하면 상시 표시로 고정됩니다"
                    MouseLeftButtonDown="AppIcon_MouseLeftButtonDown">
                <Image Source="/TWChatOverlay;component/favicon.ico"
                       Width="28" Height="28"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>

            <StackPanel x:Name="MenuBody">

            <!-- 트레이 최소화: 한글 텍스트 버튼 (리셋/닫기 버튼과 같은 시각 언어, 세로 낮게) -->
            <Button x:Name="BtnMinimize"
                    Height="18"
                    Margin="2,2,2,4"
                    HorizontalAlignment="Stretch"
                    Click="Minimize_Click"
                    ToolTip="모든 창 트레이로 최소화"
                    Cursor="Hand"
                    Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{DynamicResource OverlayTabHoverBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="MinimizeText"
                           Text="최소화"
                           FontSize="10"
                           TextAlignment="Center"
                           LineHeight="12"
                           LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource ButtonTextBrush}"/>
            </Button>

            <UniformGrid x:Name="ButtonsGrid" Rows="9" Columns="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 1: MainWindow ON/OFF -->
                <Button x:Name="BtnChat" Width="{DynamicResource MenuIconSize}" Height="{DynamicResource MenuIconSize}" Click="OpenChild_Click" ToolTip="Toggle Overlay" Style="{StaticResource MenuIconButtonStyle}" Margin="2,2,2,2">
                    <Image Source="/TWChatOverlay;component/Data/images/MenuIcon/Chat.png" MaxWidth="{DynamicResource MenuIconSize}" MaxHeight="{DynamicResource MenuIconSize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <!-- 2: TW DB 홈페이지 (에타 순위 / 장비 DB / 계산기 / 시뮬레이터 통합) -->
                <Button x:Name="BtnWebDb" Width="{DynamicResource MenuIconSize}" Height="{DynamicResource MenuIconSize}" Click="OpenChild_Click" ToolTip="TW DB 홈페이지" Style="{StaticResource MenuIconButtonStyle}" Margin="2,2,2,2">
                    <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="11" LineStackingStrategy="BlockLineHeight"><Run Text="TW"/><LineBreak/><Run Text="DB"/></TextBlock>
                </Button>
                <!-- 3: Daily/Weekly Content -->
                <Button x:Name="BtnDailyWeekly" Width="{DynamicResource MenuIconSize}" Height="{DynamicResource MenuIconSize}" Click="OpenChild_Click" ToolTip="일간/주간 컨텐츠" Style="{StaticResource MenuIconButtonStyle}" Margin="2,2,2,2">
                    <Image Source="/TWChatOverlay;component/Data/images/MenuIcon/DailyWeekly.png" MaxWidth="{DynamicResource MenuIconSize}" MaxHeight="{DynamicResource MenuIconSize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <!-- 4: Calendar -->
                <Button x:Name="BtnCalendar" Width="{DynamicResource MenuIconSize}" Height="{DynamicResource MenuIconSize}" Click="OpenChild_Click" ToolTip="달력" Style="{StaticResource MenuIconButtonStyle}" Margin="2,2,2,2">
                    <Image Source="/TWChatOverlay;component/Data/images/MenuIcon/Calendar.png" MaxWidth="{DynamicResource MenuIconSize}" MaxHeight="{DynamicResource MenuIconSize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <!-- 5: Shout Replay -->
                <Button x:Name="BtnShoutReplay" Width="{DynamicResource MenuIconSize}" Height="{DynamicResource MenuIconSize}" Click="OpenChild_Click" ToolTip="외치기 다시 보기" Style="{StaticResource MenuIconButtonStyle}" Margin="2,2,2,2">
                    <Image Source="/TWChatOverlay;component/Data/images/MenuIcon/Shout.png" MaxWidth="{DynamicResource MenuIconSize}" MaxHeight="{DynamicResource MenuIconSize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <!-- 6: Memo -->
                <Button x:Name="BtnMemo" Width="{DynamicResource MenuIconSize}" Height="{DynamicResource MenuIconSize}" Click="OpenChild_Click" ToolTip="메모장" Style="{StaticResource MenuIconButtonStyle}" Margin="2,2,2,2" Content="M"/>
                <!-- 7: 잠금 해제 모드 (오버레이 이동) -->
                <Button x:Name="BtnUnlock" Width="{DynamicResource MenuIconSize}" Height="{DynamicResource MenuIconSize}" Click="OpenChild_Click" ToolTip="잠금 해제 모드 (창 이동)" Style="{StaticResource MenuIconButtonStyle}" Margin="2,2,2,2">
                    <TextBlock x:Name="UnlockGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <!-- 8: Settings -->
                <Button x:Name="BtnSettings" Width="{DynamicResource MenuIconSize}" Height="{DynamicResource MenuIconSize}" Click="OpenChild_Click" ToolTip="설정" Style="{StaticResource MenuIconButtonStyle}" Margin="2,2,2,2" HorizontalAlignment="Center">
                    <Image Source="/TWChatOverlay;component/Data/images/MenuIcon/Setting.png" MaxWidth="{DynamicResource MenuIconSize}" MaxHeight="{DynamicResource MenuIconSize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <!-- 9: Exit -->
                <Button x:Name="BtnExit" Width="{DynamicResource MenuIconSize}" Height="{DynamicResource MenuIconSize}" Click="OpenChild_Click" ToolTip="Exit" Style="{StaticResource MenuIconButtonStyle}" Margin="2,2,2,2">
                    <Image Source="/TWChatOverlay;component/Data/images/MenuIcon/Exit.png" MaxWidth="{DynamicResource MenuIconSize}" MaxHeight="{DynamicResource MenuIconSize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </UniformGrid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
