<Window x:Class="TWChatOverlay.Views.SubMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="추가 기능"
        Height="750"
        Width="1100"
        MinHeight="520"
        MinWidth="760"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Border Background="{DynamicResource PrimaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="10,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <Grid>
                    <!-- 좌상단 브랜드 (EUI의 로고 위치) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource OverlayAccentBorderBrush}" VerticalAlignment="Center" Margin="2,1,8,0"/>
                        <TextBlock Text="테일즈 채팅 오버레이"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderTitle"
                                   Text=""
                                   Foreground="{DynamicResource OverlayHintTextBrush}"
                                   FontSize="12"
                                   Margin="10,1,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Click="CloseButton_Click"
                            Content="X"
                            Style="{StaticResource WindowCloseButtonStyle}"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Background="Transparent"
                    BorderThickness="0">
                <Border x:Name="HostContent"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4">
                    <TextBlock Text="표시할 화면이 없습니다."
                               Foreground="{DynamicResource OverlaySubtleTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
