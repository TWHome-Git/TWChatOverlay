<Window x:Class="TWChatOverlay.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TWChatOverlay.Views"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        x:Name="RootWindow"
        ShowInTaskbar="False"
        Visibility="Visible"
        Title="TW Chat Overlay" Height="230" Width="538"
        MinHeight="100" MinWidth="300"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="0">
        <!-- Main Border -->
        <Border x:Name="OuterEdge" Background="Transparent" Padding="5">
            <Border x:Name="MainBorder" TextElement.FontFamily="{Binding CurrentFont, RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{DynamicResource OverlayWindowBackgroundBrush}" CornerRadius="10"
                    BorderThickness="1.5" BorderBrush="{DynamicResource OverlayWindowBorderBrush}" ClipToBounds="False"
                    MouseEnter="MainBorder_MouseEnter"
                    MouseMove="MainBorder_MouseMove"
                    PreviewMouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="DragBarRow" Height="0"/>
                        <RowDefinition x:Name="MainTabRow" Height="0"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Drag Bar (Window Move) -->
                    <Border Grid.Row="0"
                            x:Name="DragBar"
                            Background="{DynamicResource OverlayDragBarBackgroundBrush}"
                            MouseLeftButtonDown="DragBar_MouseLeftButtonDown"
                            Visibility="Collapsed"
                            Cursor="Hand">
                        <TextBlock Text="⋮⋮ 드래그하여 창 이동 ⋮⋮"
                                   Foreground="{DynamicResource OverlayDragBarTextBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontStyle="Italic"/>
                    </Border>

                    <!-- Tab Header -->
                    <Border x:Name="MainTabBackground"
                            Grid.Row="2"
                            Height="42"
                            VerticalAlignment="Top"
                            Background="{DynamicResource OverlayHeaderBackgroundBrush}"
                            CornerRadius="3,3,0,0"
                            Visibility="Collapsed"
                            Panel.ZIndex="20"/>

                    <!-- 탭 너비는 글자 수에 비례해 나눈다 (똑같이 나누면 최소 폭 300에서 세 글자 탭 '외치기'·'시스템'이 잘린다). + 버튼은 고정 폭 -->
                    <Grid x:Name="MainTabPanel"
                          Grid.Row="2"
                          Height="42"
                          VerticalAlignment="Top"
                          Visibility="Collapsed"
                          Panel.ZIndex="21">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2.8*"/>
                            <ColumnDefinition Width="2.8*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="기본" Style="{StaticResource TabButtonStyle}" IsChecked="True" Tag="Basic" Click="Tab_Click"/>
                        <RadioButton Grid.Column="1" Content="일반" Style="{StaticResource TabButtonStyle}" Tag="General" Click="Tab_Click"/>
                        <RadioButton Grid.Column="2" Content="팀" Style="{StaticResource TabButtonStyle}" Tag="Team" Click="Tab_Click"/>
                        <RadioButton Grid.Column="3" Content="클럽" Style="{StaticResource TabButtonStyle}" Tag="Club" Click="Tab_Click"/>
                        <RadioButton Grid.Column="4" Content="외치기" Style="{StaticResource TabButtonStyle}" Tag="Shout" Click="Tab_Click"/>
                        <RadioButton Grid.Column="5" Content="시스템" Style="{StaticResource TabButtonStyle}" Tag="System" Click="Tab_Click"/>
                        <Button Grid.Column="6" Content="+" Style="{StaticResource TabActionButtonStyle}" Click="AddChatWindow_Click"/>
                    </Grid>

                    <!-- Chat View -->
                    <views:ChatView Grid.Row="2" x:Name="ChatDisplay"/>

                    <!-- Addon View (overlay) -->
                    <!--<views:AddonView Grid.Row="2" x:Name="AddonDisplay" Visibility="Collapsed"/>-->

                </Grid>
            </Border>
        </Border>

        <!-- Resize Thumbs -->
        <primitives:Thumb Height="8" VerticalAlignment="Top" Cursor="SizeNS" DragDelta="TopResize_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
        <primitives:Thumb Width="8" HorizontalAlignment="Left" Cursor="SizeWE" DragDelta="LeftResize_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
        <primitives:Thumb Width="8" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="RightResize_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
</Window>
