<Window x:Class="TWChatOverlay.Views.InitialSetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="초기 설정 마법사"
        Width="760"
        Height="520"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource OverlayShellBackgroundBrush}"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OverlaySubtleTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OverlaySurfaceAltBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource OverlaySurfaceAltBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OverlayStrongBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource OverlaySurfaceBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OverlayStrongBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource OverlaySurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource OverlayStrongBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Cursor="SizeAll">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource OverlayTitleAccentTextBrush}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                    <TextBlock Text="테일즈 채팅 오버레이"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="설정 마법사"
                               Foreground="{DynamicResource OverlayHintTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="8,1,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <Button Content="-" Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                    <Button Content="X" Click="CloseButton_Click" Style="{StaticResource WindowCloseButtonStyle}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Text="초기 설정" Foreground="{DynamicResource OverlayTitleAccentTextBrush}" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="ProgressText" Text="1 / 5" Foreground="{DynamicResource OverlaySubtleTextBrush}" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource OverlaySurfaceBackgroundBrush}" BorderBrush="{DynamicResource OverlayStrongBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="StepTitleText" Text="1. 채팅 로그 위치 설정" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StepDescText" Text="" Foreground="{DynamicResource OverlayInfoTextBrush}" FontSize="13" Margin="0,0,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="StepDetailText" Text="" Foreground="{DynamicResource OverlaySubtleTextBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>

                <ContentControl x:Name="StepContentHost" Grid.Row="1" Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SkipButton" Grid.Column="0" Width="110" Height="32" HorizontalAlignment="Left" Content="건너뛰기" Click="SkipButton_Click" Style="{DynamicResource SecondaryButtonStyle}" FontSize="12"/>
            <Button x:Name="PrevButton" Grid.Column="1" Width="110" Height="32" Margin="8,0,0,0" Content="이전" Click="PrevButton_Click" Style="{DynamicResource SecondaryButtonStyle}" FontSize="12"/>
            <Button x:Name="NextButton" Grid.Column="2" Width="110" Height="32" Margin="8,0,0,0" Content="다음" Click="NextButton_Click" Style="{DynamicResource SimButtonStyle}" FontSize="12" Foreground="White"/>
            <Button x:Name="FinishButton" Grid.Column="3" Width="110" Height="32" Margin="8,0,0,0" Content="완료" Click="FinishButton_Click" Style="{DynamicResource SimButtonStyle}" FontSize="12" Foreground="White" Visibility="Collapsed"/>
        </Grid>
    </Grid>
    </Grid>
</Window>

