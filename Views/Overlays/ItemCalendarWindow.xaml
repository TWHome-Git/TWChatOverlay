<ov:OverlayWindowBase x:Class="TWChatOverlay.Views.ItemCalendarWindow"
        xmlns:ov="clr-namespace:TWChatOverlay.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TWChatOverlay.Views"
        xmlns:converters="clr-namespace:TWChatOverlay.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="아이템 획득 내역"
        Width="1430"
        Height="880"
        MinWidth="1320"
        MinHeight="820"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded">
    <ov:OverlayWindowBase.Resources>
        <converters:AddValueConverter x:Key="AddValueConverter"/>
        <Style x:Key="CalendarTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="34"/>
        </Style>
        <!-- 도움말 [?] 버튼 (설정 화면과 동일한 모양) -->
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="집계 방식 설명"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource OverlayHintTextBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock x:Name="Glyph"
                                       Text="?"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource OverlayHintTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OverlayAccentTextBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource OverlayAccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 날짜 칸의 아이템 — 텍스트 모드: 이름과 개수를 한 줄에 -->
        <DataTemplate x:Key="CalendarEntryTextTemplate">
            <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="4,3"
                    Margin="0,0,4,4"
                    ToolTip="{Binding DisplayText}">
                <TextBlock Text="{Binding DisplayText}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <!-- 날짜 칸의 아이템 — 그림 모드: 아이콘만 네모 칸으로. 개수는 2개 이상일 때만 오른쪽 아래에 겹친다.
             칸 크기는 CalendarIconPanel이 정한다 (칸이 작으면 개수 글자도 줄인다). 이미지가 없는 아이템은 이름 첫 글자. -->
        <DataTemplate x:Key="CalendarEntryIconTemplate">
            <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    SnapsToDevicePixels="True"
                    ToolTip="{Binding DisplayText}">
                <Grid>
                    <Image Source="{Binding IconUri}"
                           Stretch="Uniform"
                           Margin="1"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Viewbox Margin="3">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <TextBlock Text="{Binding SlotGlyph}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="Bold"/>
                    </Viewbox>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,-1,-1"
                            Padding="2,0"
                            CornerRadius="3"
                            Background="#E60D1210"
                            Visibility="{Binding ShowStackCount, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock x:Name="StackCount"
                                   Text="{Binding StackCountText}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="9.5"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Path=(views:CalendarIconPanel.IsCompact), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                    <Setter TargetName="StackCount" Property="FontSize" Value="8.5"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ov:OverlayWindowBase.Resources>

    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource OverlaySurfaceAltBackgroundBrush}"
                    CornerRadius="10"
                    Padding="10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="◀"
                                Width="34"
                                Margin="0,0,6,0"
                                Style="{StaticResource CalendarTitleButtonStyle}"
                                Click="PreviousMonth_Click"/>
                        <Button Content="이번 달"
                                Width="76"
                                Margin="0,0,6,0"
                                Style="{StaticResource CalendarTitleButtonStyle}"
                                Click="ThisMonth_Click"/>
                        <Button Content="▶"
                                Width="34"
                                Style="{StaticResource CalendarTitleButtonStyle}"
                                Click="NextMonth_Click"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource OverlaySubtleTextBrush}"
                                   FontSize="12"
                                   Margin="0,0,10,0"
                                   Width="180"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <!-- 날짜 칸 표시 방식: ON=아이템 이미지, OFF=텍스트 -->
                        <CheckBox Content="아이템 이미지"
                                  FontSize="11"
                                  Foreground="{DynamicResource OverlayInfoTextBrush}"
                                  IsChecked="{Binding UseIconDisplay, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchCheckBoxStyle}"
                                  ToolTip="켜면 아이템을 그림으로, 끄면 텍스트로 표시"
                                  Margin="0,0,10,0"/>
                        <views:OverlayOpacityChip GroupKey="Calendar" SliderWidth="52" ShowValueText="False" Margin="0,0,8,0"/>
                        <!-- 본문 폰트 크기 (일일/주간 컨텐츠 창과 동일한 방식) -->
                        <Slider Width="70"
                                Minimum="10"
                                Maximum="28"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="0,0,5,0"
                                ToolTip="폰트 크기"
                                Value="{Binding ItemCalendarFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding ItemCalendarFontSizeDisplay}"
                                   Foreground="{DynamicResource OverlayInfoTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <!-- 닫기 버튼과 동일한 크기/폰트 -->
                        <Button Content="갱신"
                                Margin="0,0,6,0"
                                Height="22"
                                MinWidth="40"
                                Padding="8,0"
                                FontSize="11"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="Refresh_Click"/>
                        <Button Content="닫기"
                                Height="22"
                                MinWidth="40"
                                Padding="8,0"
                                FontSize="11"
                                Cursor="Hand"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="Close_Click"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="아이템 획득 내역"
                                       Foreground="{DynamicResource OverlayTitleAccentTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <Button Style="{StaticResource HelpButtonStyle}"
                                    Tag="calendar.aggregation"
                                    Click="Help_Click"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MonthText}"
                                   Foreground="{DynamicResource OverlayHintTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource OverlayShellBackgroundBrush}"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 요일 헤더 (월요일 시작) -->
                        <UniformGrid Columns="7" Margin="4,0,4,2">
                            <TextBlock Text="월" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OverlayInfoTextBrush}"/>
                            <TextBlock Text="화" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OverlayInfoTextBrush}"/>
                            <TextBlock Text="수" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OverlayInfoTextBrush}"/>
                            <TextBlock Text="목" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OverlayInfoTextBrush}"/>
                            <TextBlock Text="금" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OverlayInfoTextBrush}"/>
                            <TextBlock Text="토" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#7EC8FF"/>
                            <TextBlock Text="일" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                        </UniformGrid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4"
                                            Padding="8,6,8,6"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                            Background="{DynamicResource OverlayCardBackgroundBrush}"
                                            Opacity="{Binding CellOpacity}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Background="Transparent"
                                                    BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding DateLabel}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 텍스트 모드: 한 줄에 하나씩, 넘치면 휠로 넘긴다 (스크롤 막대는 숨김).
                                                 그림 모드: 넘기지 않고 칸 안에 전부 보이게 아이콘 칸 크기를 맞춘다 (CalendarIconPanel). -->
                                            <ScrollViewer Grid.Row="1"
                                                          Margin="0,6,0,0"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          CanContentScroll="False"
                                                          VerticalAlignment="Stretch">
                                                <ScrollViewer.Style>
                                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                                        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                                                        <Setter Property="Padding" Value="0,0,0,14"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.UseIconDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                            </DataTrigger>
                                                            <!-- 경험의 정수 표시가 있는 날은 그 줄만큼 아래를 비운다 -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.UseIconDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                    <Condition Binding="{Binding HasExperienceEssence}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Padding" Value="0,0,0,20"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ScrollViewer.Style>
                                                <!-- Top 고정: 영역을 세로로 늘려도 항목 높이가 커지지 않게 -->
                                                <ItemsControl ItemsSource="{Binding Entries}" VerticalAlignment="Top">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="ItemTemplate" Value="{StaticResource CalendarEntryTextTemplate}"/>
                                                            <Setter Property="ItemsPanel">
                                                                <Setter.Value>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Columns="1"/>
                                                                    </ItemsPanelTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.UseIconDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="ItemTemplate" Value="{StaticResource CalendarEntryIconTemplate}"/>
                                                                    <Setter Property="ItemsPanel">
                                                                        <Setter.Value>
                                                                            <ItemsPanelTemplate>
                                                                                <views:CalendarIconPanel/>
                                                                            </ItemsPanelTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Bottom"
                                                        ToolTip="{Binding ExperienceEssenceText}"
                                                        Visibility="{Binding HasExperienceEssence, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Source="pack://application:,,,/Data/images/Item/경험의 정수.png"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Foreground="{DynamicResource OverlayExpAccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"
                                                           Text="{Binding ExperienceEssenceCount, StringFormat=x{0:N0}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.RowSpan="2"
                                Background="{DynamicResource OverlayLoadingMaskBrush}"
                                CornerRadius="8"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="280">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding LoadProgressValue, Mode=OneWay}"
                                             Height="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource OverlayShellBackgroundBrush}"
                        CornerRadius="10"
                        Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel>
                            <Border Background="{DynamicResource OverlaySurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="9"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="클리어 보상 시드 합계"
                                               Foreground="{DynamicResource OverlayTitleAccentTextBrush}"
                                               FontSize="{Binding ItemCalendarFontSize, Converter={StaticResource AddValueConverter}, ConverterParameter=1}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MonthlySeedTotalText}"
                                                       Foreground="{DynamicResource OverlayExpAccentBrush}"
                                                       FontSize="{Binding ItemCalendarFontSize}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MonthlySeedDetailText}"
                                                       Foreground="{DynamicResource OverlayInfoTextBrush}"
                                                       FontSize="{Binding ItemCalendarFontSize}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource OverlaySurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="9"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="어밴던로드 누적 합계"
                                               Foreground="{DynamicResource OverlayTitleAccentTextBrush}"
                                               FontSize="{Binding ItemCalendarFontSize, Converter={StaticResource AddValueConverter}, ConverterParameter=1}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Margin="0,0,0,8">
                                        <TextBlock Text="{Binding MonthlyAbandonSeedText}"
                                                   Foreground="{DynamicResource OverlayExpAccentBrush}"
                                                   FontSize="{Binding ItemCalendarFontSize}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding MonthlyAbandonSummary}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                                                        BorderBrush="{DynamicResource OverlayStrongBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="7,5"
                                                        Margin="0,0,0,5">
                                                    <DockPanel LastChildFill="True">
                                                        <StackPanel Orientation="Horizontal"
                                                                    DockPanel.Dock="Left"
                                                                    VerticalAlignment="Center">
                                                            <Image Source="{Binding IconUri}"
                                                                   Width="14"
                                                                   Height="14"
                                                                   Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="{Binding NameForegroundHex}"
                                                                       FontSize="{Binding DataContext.ItemCalendarFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding CountText}"
                                                                   Foreground="{Binding CountForegroundHex}"
                                                                   FontSize="{Binding DataContext.ItemCalendarFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Right"
                                                                   DockPanel.Dock="Right"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource OverlaySurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="9">
                                <StackPanel>
                                    <TextBlock Text="아이템 득템 누적 합계"
                                               Foreground="{DynamicResource OverlayTitleAccentTextBrush}"
                                               FontSize="{Binding ItemCalendarFontSize, Converter={StaticResource AddValueConverter}, ConverterParameter=1}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <ItemsControl ItemsSource="{Binding MonthlySummary}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                                                        BorderBrush="{Binding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="7,5"
                                                        Margin="0,0,0,5">
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="{Binding DataContext.ItemCalendarFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding Count, StringFormat=x{0:N0}}"
                                                                   Foreground="{DynamicResource OverlayInfoTextBrush}"
                                                                   FontSize="{Binding DataContext.ItemCalendarFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Right"
                                                                   DockPanel.Dock="Right"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource OverlaySurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="9"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="경험의 정수 누적 합계"
                                               Foreground="{DynamicResource OverlayTitleAccentTextBrush}"
                                               FontSize="{Binding ItemCalendarFontSize, Converter={StaticResource AddValueConverter}, ConverterParameter=1}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel Orientation="Horizontal"
                                                        DockPanel.Dock="Left"
                                                        VerticalAlignment="Center">
                                                <Image Source="pack://application:,,,/Data/images/Item/경험의 정수.png"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MonthlyExperienceEssenceSeedText}"
                                                           Foreground="{DynamicResource OverlayExpAccentBrush}"
                                                           FontSize="{Binding ItemCalendarFontSize}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
