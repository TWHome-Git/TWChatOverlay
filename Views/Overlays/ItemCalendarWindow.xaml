<Window x:Class="TWChatOverlay.Views.ItemCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TWChatOverlay.Views"
        xmlns:converters="clr-namespace:TWChatOverlay.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="아이템 획득 내역"
        Width="1430"
        Height="880"
        MinWidth="1320"
        MinHeight="820"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:AddValueConverter x:Key="AddValueConverter"/>
        <Style x:Key="CalendarTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="34"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource OverlaySurfaceAltBackgroundBrush}"
                    CornerRadius="4"
                    Padding="10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="◀"
                                Width="34"
                                Margin="0,0,6,0"
                                Style="{StaticResource CalendarTitleButtonStyle}"
                                Click="PreviousMonth_Click"/>
                        <Button Content="이번달"
                                Width="76"
                                Margin="0,0,6,0"
                                Style="{StaticResource CalendarTitleButtonStyle}"
                                Click="ThisMonth_Click"/>
                        <Button Content="▶"
                                Width="34"
                                Style="{StaticResource CalendarTitleButtonStyle}"
                                Click="NextMonth_Click"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource OverlaySubtleTextBrush}"
                                   FontSize="12"
                                   Margin="0,0,10,0"
                                   Width="180"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <!-- 날짜 칸 표시 방식: ON=아이템 이미지, OFF=텍스트 -->
                        <CheckBox Content="아이템 이미지"
                                  FontSize="11"
                                  Foreground="{DynamicResource OverlayInfoTextBrush}"
                                  IsChecked="{Binding UseIconDisplay, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchCheckBoxStyle}"
                                  ToolTip="켜면 아이템을 그림으로, 끄면 텍스트로 표시"
                                  Margin="0,0,10,0"/>
                        <views:OverlayOpacityChip GroupKey="Calendar" SliderWidth="52" ShowValueText="False" Margin="0,0,8,0"/>
                        <!-- 본문 폰트 크기 (일일/주간 컨텐츠 창과 동일한 방식) -->
                        <Slider Width="70"
                                Minimum="10"
                                Maximum="28"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="0,0,5,0"
                                ToolTip="폰트 크기"
                                Value="{Binding ItemCalendarFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding ItemCalendarFontSizeDisplay}"
                                   Foreground="{DynamicResource OverlayInfoTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <!-- 닫기 버튼과 동일한 크기/폰트 -->
                        <Button Content="갱신"
                                Margin="0,0,6,0"
                                Height="22"
                                MinWidth="40"
                                Padding="8,0"
                                FontSize="11"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="Refresh_Click"/>
                        <Button Content="X"
                                Style="{StaticResource WindowCloseButtonStyle}"
                                Click="Close_Click"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="아이템 획득 내역"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MonthText}"
                                   Foreground="{DynamicResource OverlayInfoTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource OverlayShellBackgroundBrush}"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,10,0">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4"
                                            Padding="10"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                            Background="{DynamicResource OverlayCardBackgroundBrush}"
                                            Opacity="{Binding CellOpacity}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Background="Transparent"
                                                    BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="6,4">
                                                <TextBlock Text="{Binding DateLabel}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <ScrollViewer Grid.Row="1"
                                                          Margin="0,10,0,0"
                                                          VerticalScrollBarVisibility="Hidden"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          CanContentScroll="False"
                                                          VerticalAlignment="Stretch"
                                                          Padding="0,0,0,20">
                                                <!-- Top 고정: 스크롤 영역이 세로로 늘려도 항목 높이가 커지지 않게 -->
                                                <ItemsControl ItemsSource="{Binding Entries}" VerticalAlignment="Top">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <!-- 텍스트 모드: 한 줄에 1개 -->
                                                            <Setter Property="ItemsPanel">
                                                                <Setter.Value>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Columns="1"/>
                                                                    </ItemsPanelTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <!-- 그림 모드: 한 줄에 2개 -->
                                                                <DataTrigger Binding="{Binding DataContext.UseIconDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="ItemsPanel">
                                                                        <Setter.Value>
                                                                            <ItemsPanelTemplate>
                                                                                <UniformGrid Columns="2"/>
                                                                            </ItemsPanelTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemTemplate>
                                                        <!-- 아이콘이 있는 아이템은 이미지(+개수), 없는 아이템은 기존 텍스트 -->
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                                                                    BorderBrush="{Binding BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2"
                                                                    Padding="4,3"
                                                                    Margin="0,0,4,4"
                                                                    ToolTip="{Binding DisplayText}">
                                                                <!-- 표시 우선순위(그림 모드): 아이콘 > 글자 대체([테]) > 텍스트.
                                                                     텍스트 모드(UseIconDisplay=false)에서는 항상 텍스트만.
                                                                     가시성은 로컬 값 우선순위 문제를 피하려고 전부 Style 트리거로 제어. -->
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock x:Name="EntryCount"
                                                                               DockPanel.Dock="Right"
                                                                               Text="{Binding CountBadgeText}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               Margin="3,0,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ShowCountBadge}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding DataContext.UseIconDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock x:Name="EntryText"
                                                                               Text="{Binding DisplayText}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HasGlyph}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding DataContext.UseIconDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <!-- 높이 고정: 모든 아이콘 칩이 동일한 크기로 표시 -->
                                                                    <Grid>
                                                                        <Image x:Name="EntryIcon"
                                                                               Source="{Binding IconUri}"
                                                                               Stretch="Uniform"
                                                                               Height="30"
                                                                               VerticalAlignment="Center">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding DataContext.UseIconDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>
                                                                        <TextBlock x:Name="EntryGlyph"
                                                                                   Text="{Binding FallbackGlyph}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontSize="20"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasGlyph}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding DataContext.UseIconDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Bottom"
                                                        ToolTip="{Binding ExperienceEssenceText}"
                                                        Visibility="{Binding HasExperienceEssence, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Source="pack://application:,,,/Data/images/Item/경험의 정수.png"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Foreground="{DynamicResource OverlayExpAccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"
                                                           Text="{Binding ExperienceEssenceCount, StringFormat=x{0:N0}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource OverlayLoadingMaskBrush}"
                                CornerRadius="3"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="280">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding LoadProgressValue}"
                                             Height="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource OverlayShellBackgroundBrush}"
                        CornerRadius="4"
                        Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel>
                            <Border Background="{DynamicResource OverlaySurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="9"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="어밴던 누적 합계"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="{Binding ItemCalendarFontSize, Converter={StaticResource AddValueConverter}, ConverterParameter=1}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="8,6"
                                            Margin="0,0,0,8">
                                        <TextBlock Text="{Binding MonthlyAbandonSeedText}"
                                                   Foreground="{DynamicResource OverlayExpAccentBrush}"
                                                   FontSize="{Binding ItemCalendarFontSize}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding MonthlyAbandonSummary}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                                                        BorderBrush="{DynamicResource OverlayStrongBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="7,5"
                                                        Margin="0,0,0,5">
                                                    <DockPanel LastChildFill="True">
                                                        <StackPanel Orientation="Horizontal"
                                                                    DockPanel.Dock="Left"
                                                                    VerticalAlignment="Center">
                                                            <Image Source="{Binding IconUri}"
                                                                   Width="14"
                                                                   Height="14"
                                                                   Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="{Binding NameForegroundHex}"
                                                                       FontSize="{Binding DataContext.ItemCalendarFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding CountText}"
                                                                   Foreground="{Binding CountForegroundHex}"
                                                                   FontSize="{Binding DataContext.ItemCalendarFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Right"
                                                                   DockPanel.Dock="Right"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource OverlaySurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="9">
                                <StackPanel>
                                    <TextBlock Text="아이템 득템 누적 합계"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="{Binding ItemCalendarFontSize, Converter={StaticResource AddValueConverter}, ConverterParameter=1}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <ItemsControl ItemsSource="{Binding MonthlySummary}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                                                        BorderBrush="{Binding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="7,5"
                                                        Margin="0,0,0,5">
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="{Binding DataContext.ItemCalendarFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding Count, StringFormat=x{0:N0}}"
                                                                   Foreground="{DynamicResource OverlayInfoTextBrush}"
                                                                   FontSize="{Binding DataContext.ItemCalendarFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Right"
                                                                   DockPanel.Dock="Right"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource OverlaySurfaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="9"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="경험의 정수 누적 합계"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="{Binding ItemCalendarFontSize, Converter={StaticResource AddValueConverter}, ConverterParameter=1}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <Border Background="{DynamicResource OverlayCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="8,6">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel Orientation="Horizontal"
                                                        DockPanel.Dock="Left"
                                                        VerticalAlignment="Center">
                                                <Image Source="pack://application:,,,/Data/images/Item/경험의 정수.png"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MonthlyExperienceEssenceSeedText}"
                                                           Foreground="{DynamicResource OverlayExpAccentBrush}"
                                                           FontSize="{Binding ItemCalendarFontSize}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
