<ov:ToastWindowBase x:Class="TWChatOverlay.Views.DungeonCountDisplayWindow"
        xmlns:ov="clr-namespace:TWChatOverlay.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="280"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Opacity="0">
    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayAccentBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="8"
            Padding="16,9,16,10"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <!-- 문구("어밴던로드 3단계" 등)와 아이콘만 보여준다 — "던전 도우미" 제목은 두지 않고, 크기는 문구에 맞춘다 -->
            <Grid>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image x:Name="MessageIcon"
                           Width="26" Height="26"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="Collapsed"/>
                    <TextBlock x:Name="MessageTextBlock"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ov:ToastWindowBase>
