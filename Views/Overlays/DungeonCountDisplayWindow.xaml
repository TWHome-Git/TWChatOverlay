<Window x:Class="TWChatOverlay.Views.DungeonCountDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Opacity="0">
    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayAccentBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="8"
            Padding="16,10"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <Grid x:Name="NormalContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="던전 도우미"
                           Foreground="{DynamicResource OverlayTitleAccentTextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Center"/>

                <TextBlock x:Name="MessageTextBlock"
                           Grid.Row="1"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="18"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- 잠금 해제(위치 미리보기) 공통 라벨 -->
            <TextBlock x:Name="PreviewLabel"
                       Text="던전 도우미 알림창"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
