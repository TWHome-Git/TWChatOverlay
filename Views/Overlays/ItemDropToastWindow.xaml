<Window x:Class="TWChatOverlay.Views.ItemDropToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="56"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">
    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayAccentBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="8"
            Padding="12,6">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Image x:Name="ItemIcon"
                   Width="28"
                   Height="28"
                   Margin="0,0,8,0"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
            <TextBlock x:Name="ItemNameText"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
