<Window x:Class="TWChatOverlay.Views.ItemDropHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="72"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayAccentBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="8"
            Padding="12,6"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <!-- 위치 표시 전용 창 — 잠금 해제 공통 라벨 형식 -->
            <TextBlock x:Name="PreviewLabel"
                       Text="아이템 드롭 알림창"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
