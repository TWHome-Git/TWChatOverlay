<Window x:Class="TWChatOverlay.Views.ExperienceAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">
    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayWarningBorderBrush}"
            BorderThickness="1.4"
            CornerRadius="10"
            Padding="14,12"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <Grid x:Name="NormalContent">
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"
                        Content="X"
                        Style="{StaticResource WindowCloseButtonStyle}"/>

                <TextBlock x:Name="MessageTextBlock"
                           Margin="34,0,34,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"/>
            </Grid>

            <!-- 잠금 해제(위치 미리보기) 공통 라벨 -->
            <TextBlock x:Name="PreviewLabel"
                       Text="경험치 누적 알림창"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
