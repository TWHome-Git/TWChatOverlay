<Window x:Class="TWChatOverlay.Views.ExperienceAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">
    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayWarningBorderBrush}"
            BorderThickness="1.4"
            CornerRadius="10"
            Padding="14,12"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <Grid x:Name="NormalContent">
                <!-- 오른쪽: [수정] 위 / [닫기] 아래 -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Height="22"
                            MinWidth="40"
                            Cursor="Hand"
                            Click="EditButton_Click"
                            ToolTip="누적 알림 ON/OFF와 저장된 누적 경험치를 바로 수정합니다">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        Background="{DynamicResource OverlayTabHoverBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,0">
                                    <TextBlock Text="설정"
                                               FontSize="11"
                                               Foreground="{DynamicResource ButtonTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Margin="0,4,0,0"
                            Click="CloseButton_Click"
                            Content="X"
                            Style="{StaticResource WindowCloseButtonStyle}"/>
                </StackPanel>

                <TextBlock x:Name="MessageTextBlock"
                           Margin="44,0,58,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"/>
            </Grid>

            <!-- 잠금 해제(위치 미리보기) 공통 라벨 -->
            <TextBlock x:Name="PreviewLabel"
                       Text="경험치 누적 알림창"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
