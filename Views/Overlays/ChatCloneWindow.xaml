<Window x:Class="TWChatOverlay.Views.ChatCloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TWChatOverlay.Views"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        x:Name="RootWindow"
        ShowInTaskbar="False"
        Visibility="Visible"
        Title="TW Chat Overlay"
        Height="230"
        Width="538"
        MinHeight="180"
        MinWidth="538"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid Margin="0">
        <Border Background="Transparent" Padding="5">
            <Border x:Name="MainBorder"
                    TextElement.FontFamily="{Binding CurrentFont, RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{DynamicResource OverlayWindowBackgroundBrush}"
                    CornerRadius="10"
                    BorderThickness="1.5"
                    BorderBrush="{DynamicResource OverlayWindowBorderBrush}"
                    ClipToBounds="True"
                    MouseEnter="MainBorder_MouseEnter"
                    MouseMove="MainBorder_MouseMove"
                    PreviewMouseLeftButtonDown="UnlockDrag_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 탭은 채팅 영역 위에 겹쳐서 표시(오버레이). 숨겨지면 공간을 차지하지 않는다. -->
                    <Border x:Name="MainTabBackground"
                            Grid.Row="2"
                            Height="42"
                            VerticalAlignment="Top"
                            Background="{DynamicResource OverlayHeaderBackgroundBrush}"
                            CornerRadius="3,3,0,0"
                            Panel.ZIndex="20"/>

                    <Grid x:Name="MainTabPanel" Grid.Row="2" Height="42" VerticalAlignment="Top" Panel.ZIndex="21">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <UniformGrid Grid.Column="0" Columns="5">
                            <RadioButton Content="일반" Style="{StaticResource TabButtonStyle}" IsChecked="True" Tag="General" Click="Tab_Click"/>
                            <RadioButton Content="팀" Style="{StaticResource TabButtonStyle}" Tag="Team" Click="Tab_Click"/>
                            <RadioButton Content="클럽" Style="{StaticResource TabButtonStyle}" Tag="Club" Click="Tab_Click"/>
                            <RadioButton Content="외치기" Style="{StaticResource TabButtonStyle}" Tag="Shout" Click="Tab_Click"/>
                            <RadioButton Content="시스템" Style="{StaticResource TabButtonStyle}" Tag="System" Click="Tab_Click"/>
                        </UniformGrid>

                        <Button Grid.Column="1"
                                Content="X"
                                Style="{StaticResource WindowCloseButtonStyle}"
                                Margin="0,0,6,0"
                                ToolTip="채팅창 끄기"
                                Click="CloseChat_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <views:ChatView x:Name="ChatDisplay"/>

                    </Grid>
                </Grid>
            </Border>
        </Border>

        <primitives:Thumb Height="8" VerticalAlignment="Top" Cursor="SizeNS" DragStarted="ResizeThumb_DragStarted" DragDelta="TopResize_DragDelta" DragCompleted="ResizeThumb_DragCompleted">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
        <primitives:Thumb Width="8" HorizontalAlignment="Left" Cursor="SizeWE" DragStarted="ResizeThumb_DragStarted" DragDelta="LeftResize_DragDelta" DragCompleted="ResizeThumb_DragCompleted">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
        <primitives:Thumb Width="8" HorizontalAlignment="Right" Cursor="SizeWE" DragStarted="ResizeThumb_DragStarted" DragDelta="RightResize_DragDelta" DragCompleted="ResizeThumb_DragCompleted">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
</Window>
