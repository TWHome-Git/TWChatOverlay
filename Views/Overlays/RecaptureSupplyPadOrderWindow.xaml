<Window x:Class="TWChatOverlay.Views.RecaptureSupplyPadOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보급품 탈환 발판"
        Width="300"
        Height="150"
        MinWidth="190"
        MinHeight="110"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 발판 한 칸. 게임에서 잘라 온 그림(Data/images/Pads)을 넣는다.
             실제 크기는 Viewbox가 창 크기에 맞춰 늘리고 줄인다. -->
        <Style x:Key="RecapturePadImageStyle" TargetType="Image">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayAccentBorderBrush}"
            BorderThickness="1.4"
            CornerRadius="12"
            Padding="10,6,10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 제목줄: 잠금 해제 모드에서 잡고 끌 수 있다 -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  MinHeight="26"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"
                        Content="X"
                        Style="{StaticResource WindowCloseButtonStyle}"/>
            </Grid>

            <!-- 감지된 문구. 어떤 글로 이 순서가 나왔는지 바로 확인할 수 있다 -->
            <TextBlock x:Name="PhraseText"
                       Grid.Row="1"
                       Foreground="{DynamicResource TextBrush}"
                       Opacity="0.62"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <Viewbox Grid.Row="2" Stretch="Uniform">
                <StackPanel x:Name="PadPanel"
                            Orientation="Horizontal"
                            Margin="2">
                    <Image x:Name="Pad1" Style="{StaticResource RecapturePadImageStyle}"/>
                    <Image x:Name="Pad2" Style="{StaticResource RecapturePadImageStyle}" Margin="-14,0,0,0"/>
                    <Image x:Name="Pad3" Style="{StaticResource RecapturePadImageStyle}" Margin="-14,0,0,0"/>
                </StackPanel>
            </Viewbox>
        </Grid>
    </Border>
</Window>
