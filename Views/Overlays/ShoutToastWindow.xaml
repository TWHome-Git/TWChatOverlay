<ov:ToastWindowBase x:Class="TWChatOverlay.Views.ShoutToastWindow"
        xmlns:ov="clr-namespace:TWChatOverlay.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="420"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False">
    <Border x:Name="RootBorder"
            Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayShoutBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="10"
            Padding="12,9,14,10"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="6"
                    CornerRadius="3"
                    Background="{DynamicResource OverlayShoutFillBrush}"
                    VerticalAlignment="Stretch"
                    Margin="0,0,10,0"/>

            <!-- 주황 테두리·막대가 외치기임을 알려 주므로 "외치기" 제목은 두지 않는다 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ToastText"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</ov:ToastWindowBase>
