<Window x:Class="TWChatOverlay.Views.BuffTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MaxWidth="420"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 버프 타일: 아이콘 + 오른쪽에 남은 시간. 판 위에 올려 게임 화면과 상관없이 읽힌다. -->
        <DataTemplate x:Key="BuffTileTemplate">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,12,0"
                        ToolTip="{Binding DisplayName}">
                <Border Width="26"
                        Height="26"
                        CornerRadius="5"
                        Background="{DynamicResource OverlayBuffTileBackgroundBrush}"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="1">
                    <Image Source="{Binding IconSource}"
                           Stretch="Uniform"
                           Margin="2"/>
                </Border>
                <TextBlock Text="{Binding RemainingText}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="7,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,7"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <!-- 레어/경험치 구분은 아이콘 테두리 색(골드/하늘색)이 대신한다 — 머리글 없이 한 줄로 -->
        <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding ActiveRareBuffs}"
                          ItemTemplate="{StaticResource BuffTileTemplate}"
                          Visibility="{Binding HasRareBuffs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ActiveExpBuffs}"
                          ItemTemplate="{StaticResource BuffTileTemplate}"
                          Visibility="{Binding HasExpBuffs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
