<Window x:Class="TWChatOverlay.Views.BuffTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MaxWidth="420"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 버프 타일: 아이콘(이중 테두리) + 아래 남은 시간. 판 없이 아이콘만 떠 있는 형태. -->
        <DataTemplate x:Key="BuffTileTemplate">
            <StackPanel Margin="3,0,3,0" ToolTip="{Binding DisplayName}">
                <Border Background="#FF060A08"
                        BorderBrush="#FF060A08"
                        BorderThickness="1"
                        CornerRadius="2">
                    <Border BorderBrush="{Binding AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="1"
                            Background="{DynamicResource OverlayBuffTileBackgroundBrush}">
                        <Image Source="{Binding IconSource}"
                               Width="30"
                               Height="30"
                               Stretch="Uniform"/>
                    </Border>
                </Border>
                <TextBlock Text="{Binding RemainingText}"
                           Foreground="{DynamicResource OverlayInfoTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- 배경은 드래그 히트 영역 확보용 (거의 투명) -->
    <Border Background="#01000000"
            Padding="4"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding ActiveRareBuffs}"
                          ItemTemplate="{StaticResource BuffTileTemplate}"
                          Visibility="{Binding HasRareBuffs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ActiveExpBuffs}"
                          ItemTemplate="{StaticResource BuffTileTemplate}"
                          Visibility="{Binding HasExpBuffs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
