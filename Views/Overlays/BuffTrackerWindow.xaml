<Window x:Class="TWChatOverlay.Views.BuffTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MaxWidth="680"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 버프 타일: 아이콘 + 오른쪽에 남은 시간. 판 위에 올려 게임 화면과 상관없이 읽힌다. -->
        <DataTemplate x:Key="BuffTileTemplate">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,12,5"
                        ToolTip="{Binding DisplayName}">
                <Border Width="26"
                        Height="26"
                        CornerRadius="5"
                        Background="{DynamicResource OverlayBuffTileBackgroundBrush}"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="1">
                    <Image Source="{Binding IconSource}"
                           Stretch="Uniform"
                           Margin="2"/>
                </Border>
                <TextBlock Text="{Binding RemainingText}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="7,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,7"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <!-- 세로 배치 + 그룹별 WrapPanel: 가로 StackPanel은 폭 제한을 전달하지 않아
             MaxWidth를 넘는 타일이 잘려 보이던 문제가 있었다. 레어/경험치 라벨로 분류 표시. -->
        <StackPanel>
            <StackPanel Visibility="{Binding HasRareBuffs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="레어"
                           Foreground="{DynamicResource OverlayRareAccentBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding ActiveRareBuffs}"
                              ItemTemplate="{StaticResource BuffTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <StackPanel Visibility="{Binding HasExpBuffs, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,3,0,0">
                <TextBlock Text="경험치"
                           Foreground="{DynamicResource OverlayExpAccentBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding ActiveExpBuffs}"
                              ItemTemplate="{StaticResource BuffTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
