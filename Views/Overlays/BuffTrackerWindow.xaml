<ov:OverlayWindowBase x:Class="TWChatOverlay.Views.BuffTrackerWindow"
        xmlns:ov="clr-namespace:TWChatOverlay.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MaxWidth="680"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True">
    <!-- 버프 타일(BuffTileTemplate)과 BooleanToVisibilityConverter는 Resources/Styles.xaml(앱 리소스)에 있다 -->
    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,7"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <!-- 세로 배치 + 그룹별 WrapPanel: 가로 StackPanel은 폭 제한을 전달하지 않아
             MaxWidth를 넘는 타일이 잘려 보이던 문제가 있었다. 레어/경험치 라벨로 분류 표시. -->
        <StackPanel>
            <StackPanel Visibility="{Binding HasRareBuffs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="레어"
                           Foreground="{DynamicResource OverlayRareAccentBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding ActiveRareBuffs}"
                              ItemTemplate="{StaticResource BuffTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <StackPanel Visibility="{Binding HasExpBuffs, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,3,0,0">
                <TextBlock Text="경험치"
                           Foreground="{DynamicResource OverlayExpAccentBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding ActiveExpBuffs}"
                              ItemTemplate="{StaticResource BuffTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</ov:OverlayWindowBase>
