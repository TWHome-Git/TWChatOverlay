<Window x:Class="TWChatOverlay.Views.BuffTrackerHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MaxWidth="680"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True">
    <Window.Resources>
        <!-- 실제 버프 추적창과 동일한 타일 (BuffTrackerWindow.xaml 참고) -->
        <DataTemplate x:Key="BuffTileTemplate">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,12,5"
                        ToolTip="{Binding DisplayName}">
                <Border Width="26"
                        Height="26"
                        CornerRadius="5"
                        Background="{DynamicResource OverlayBuffTileBackgroundBrush}"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="1">
                    <Image Source="{Binding IconSource}"
                           Stretch="Uniform"
                           Margin="2"/>
                </Border>
                <TextBlock Text="{Binding RemainingText}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="7,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayHelperWindowBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="8"
            Padding="10,7"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <!-- 모든 버프가 켜졌을 때 기준의 최대 크기 미리보기 (실제 창과 동일한 그룹 구조) -->
        <StackPanel>
            <TextBlock Text="레어"
                       Foreground="{DynamicResource OverlayRareAccentBrush}"
                       FontSize="11"
                       FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <ItemsControl x:Name="PreviewRareItems"
                          ItemTemplate="{StaticResource BuffTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="경험치"
                       Foreground="{DynamicResource OverlayExpAccentBrush}"
                       FontSize="11"
                       FontWeight="Bold"
                       Margin="0,3,0,4"/>
            <ItemsControl x:Name="PreviewExpItems"
                          ItemTemplate="{StaticResource BuffTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
