<Window x:Class="TWChatOverlay.Views.AbandonRoadSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TWChatOverlay.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="어밴던로드 통계"
        Width="384"
        SizeToContent="Height"
        MinWidth="344"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded">
    <Border Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,12,16,12"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right"
                        Content="닫기"
                        Height="22"
                        MinWidth="40"
                        Padding="8,0,8,0"
                        FontSize="11"
                        Cursor="Hand"
                        VerticalAlignment="Top"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="Close_Click"/>
                <StackPanel>
                    <TextBlock Text="어밴던로드 통계"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OverlayTitleAccentTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button x:Name="PrevWeekButton"
                                Content="◀"
                                Width="22"
                                Height="18"
                                FontSize="9"
                                Padding="0"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="PrevWeek_Click"/>
                        <TextBlock Text="{Binding WeekText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource OverlayHintTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,4,0"/>
                        <Button x:Name="NextWeekButton"
                                Content="▶"
                                Width="22"
                                Height="18"
                                FontSize="9"
                                Padding="0"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="NextWeek_Click"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="2,0,2,8">
                <TextBlock Text="{Binding SummaryText}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource OverlayTitleAccentTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding StoneEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4,2,4" LastChildFill="True">
                            <TextBlock Text="{Binding CountText}"
                                       Foreground="{Binding CountForegroundHex}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding IconUri}"
                                       Width="18"
                                       Height="18"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{Binding NameForegroundHex}"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
