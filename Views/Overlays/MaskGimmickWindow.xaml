<ov:ToastWindowBase x:Class="TWChatOverlay.Views.MaskGimmickWindow"
        xmlns:ov="clr-namespace:TWChatOverlay.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="격리실 가면"
        SizeToContent="WidthAndHeight"
        MinWidth="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="RootBorder"
            Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayAccentBorderBrush}"
            BorderThickness="1.4"
            CornerRadius="12"
            UseLayoutRounding="True"
            Padding="12,6,12,10">
        <StackPanel x:Name="ContentPanel" MouseLeftButtonDown="Content_MouseLeftButtonDown" Background="Transparent">
            <!-- 보스가 쓴 가면 (왜 이 가면을 부숴야 하는지) -->
            <TextBlock x:Name="WearingText"
                       Foreground="{DynamicResource TextBrush}"
                       Opacity="0.75"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <!-- 부술 가면: 게임에서 가져온 그림 (Data/images/Masks). 도트 그림이라 보간 없이 키운다. 크기는 코드가 표시 배율로 정한다 -->
            <Image x:Name="MaskImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   SnapsToDevicePixels="True"/>

            <TextBlock x:Name="TargetText"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>

            <!-- 즐거움 폭발까지 남은 시간 -->
            <TextBlock x:Name="RemainText"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="13"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</ov:ToastWindowBase>
