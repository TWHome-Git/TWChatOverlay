<ov:ToastWindowBase x:Class="TWChatOverlay.Views.DoomSentenceCaptureWindow"
        xmlns:ov="clr-namespace:TWChatOverlay.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="운명 선고 순서"
        SizeToContent="WidthAndHeight"
        MinWidth="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="RootBorder"
            Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayAccentBorderBrush}"
            BorderThickness="1.4"
            CornerRadius="12"
            UseLayoutRounding="True"
            Padding="8,5,8,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 제목줄: 회차 · 진행 · 남은 시간. 잠금 해제 모드에서 잡고 끌 수 있다 -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  MinHeight="22"
                  Margin="2,0,2,4"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText"
                           Grid.Column="0"
                           Foreground="{DynamicResource TextBrush}"
                           Opacity="0.8"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <!-- 밟은 수 / 전체. 로그의 "발판을 밟았습니다. (1 / 6)" 줄로 올린다 -->
                <TextBlock x:Name="ProgressText"
                           Grid.Column="1"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
                <TextBlock x:Name="RemainText"
                           Grid.Column="2"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           MinWidth="38"
                           TextAlignment="Right"
                           Margin="10,0,0,0"/>
            </Grid>

            <!-- 밟을 순서: 둥근 색 버튼 위에 흰 화살표, 왼쪽에서 오른쪽으로 (한 줄에 넷, 게임 공지와 같은 줄바꿈).
                 아이콘은 코드(BuildOrderIcons)가 만든다. 밟은 것은 흐리게, 다음에 밟을 것은 금색 테로 강조한다 -->
            <WrapPanel x:Name="OrderPanel"
                       Grid.Row="1"
                       Orientation="Horizontal"
                       HorizontalAlignment="Left"
                       Visibility="Collapsed"/>

            <!-- 읽는 중 · 못 읽음 같은 한 줄 안내 -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Foreground="{DynamicResource TextBrush}"
                       Opacity="0.7"
                       FontSize="12"
                       Margin="4,2,4,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <!-- 순서를 끝내 못 읽었을 때만 대신 보여 주는 찍은 화면 (찍힌 크기 × 표시 배율) -->
            <Image x:Name="CaptureImage"
                   Grid.Row="1"
                   Stretch="Fill"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   SnapsToDevicePixels="True"
                   Visibility="Collapsed"/>
        </Grid>
    </Border>
</ov:ToastWindowBase>
