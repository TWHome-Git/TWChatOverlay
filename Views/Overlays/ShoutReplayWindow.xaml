<Window x:Class="TWChatOverlay.Views.ShoutReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="외치기 로그"
        Height="640"
        Width="920"
        MinHeight="420"
        MinWidth="620"
        Background="{DynamicResource OverlayShellBackgroundBrush}"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Border Margin="10"
            Background="{DynamicResource OverlayShellBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource OverlaySurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource OverlayStrongBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="4,4,0,0"
                    Padding="10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <Grid>
                    <TextBlock Text="외치기 로그"
                               Foreground="{DynamicResource OverlayTitleAccentTextBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <!-- 본문 폰트 크기 조절 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <TextBlock Text="폰트"
                                   Foreground="{DynamicResource OverlaySubtleTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <Slider x:Name="FontSizeSlider"
                                Width="90"
                                Minimum="10"
                                Maximum="28"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="FontSizeSlider_ValueChanged"/>
                        <TextBlock x:Name="FontSizeText"
                                   Foreground="{DynamicResource OverlayInfoTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Width="34"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Click="CloseButton_Click"
                            Content="X"
                            Style="{StaticResource WindowCloseButtonStyle}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox"
                             DockPanel.Dock="Right"
                             Width="240" Height="30"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             Background="{DynamicResource InputFieldBackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource InputFieldBorderBrush}"
                             BorderThickness="1"
                             ToolTip="외치기 내용/닉네임 검색 (Esc: 지우기)"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"/>
                    <TextBlock x:Name="SearchInfo"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource OverlaySubtleTextBrush}"/>
                    <Button x:Name="BtnPrev" Content="&lt;" Width="34" Height="30" Margin="0,0,6,0" Click="Prev_Click"/>
                    <Button x:Name="BtnDate" Content="-" Width="180" Height="30" Click="Date_Click"/>
                    <Button x:Name="BtnNext" Content="&gt;" Width="34" Height="30" Margin="6,0,0,0" Click="Next_Click"/>
                    <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=BtnDate}" Placement="Bottom" StaysOpen="False">
                        <Border Background="{DynamicResource OverlaySurfaceBackgroundBrush}" BorderBrush="{DynamicResource OverlayCardBorderBrush}" BorderThickness="1" Padding="8">
                            <DatePicker x:Name="DatePickerLog" SelectedDateChanged="DatePickerLog_SelectedDateChanged"/>
                        </Border>
                    </Popup>
                </DockPanel>

                <Grid Grid.Row="1" PreviewMouseDown="LogArea_PreviewMouseDown">
                    <Border Background="{DynamicResource OverlayShellBackgroundBrush}" BorderBrush="{DynamicResource OverlayCardBorderBrush}" BorderThickness="1" CornerRadius="2">
                        <RichTextBox x:Name="LogRichText"
                                     IsReadOnly="True"
                                     IsDocumentEnabled="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Padding="8"
                                     PreviewMouseWheel="LogRichText_PreviewMouseWheel"/>
                    </Border>
                    <Border x:Name="LoadingOverlay" Background="{DynamicResource OverlayLoadingMaskBrush}" Visibility="Collapsed" CornerRadius="2">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="로딩 중.." Foreground="{DynamicResource TextBrush}" FontSize="18" HorizontalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Width="180" Height="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
