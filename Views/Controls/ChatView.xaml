<UserControl x:Class="TWChatOverlay.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TWChatOverlay.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid>
        <!-- 채팅 줄을 직접 그리는 표시 영역 + 스크롤 막대. 예전 RichTextBox는 줄 하나가 바뀔 때마다 문서 전체 배치를 다시 했다 -->
        <Grid Margin="5,5,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 좌우 5px 안쪽 여백: 예전 RichTextBox의 글 영역과 같은 자리·같은 줄바꿈 너비 -->
            <local:ChatLineDisplay x:Name="LogDisplay" Grid.Column="0" Margin="5,0,5,0"/>
            <ScrollBar x:Name="LogScrollBar"
                       Grid.Column="1"
                       Orientation="Vertical"
                       Style="{StaticResource OverlayScrollBarStyle}"
                       Visibility="Collapsed"
                       ValueChanged="LogScrollBar_ValueChanged"/>
        </Grid>

        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,12,12">
            <Button Content="▼" Width="26" Height="26"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    FontSize="12" Cursor="Hand"
                    Click="ScrollToBottom_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource OverlayScrollButtonBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource OverlayScrollButtonBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutoScrollEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource OverlayScrollButtonHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
