<UserControl x:Class="TWChatOverlay.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:TWChatOverlay.Views"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- 왼쪽 내비게이션 항목: 선택 시 왼쪽 2px 민트 라인 + 밝은 텍스트 -->
        <Style x:Key="SettingsNavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource OverlaySubtleTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2,0,0,0"
                                Padding="12,7">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayTabHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 내비게이션 그룹 라벨 -->
        <Style x:Key="SettingsNavGroupLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OverlayHintTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="14,12,0,4"/>
        </Style>

        <!-- 섹션 라벨: 작은 회색 구분 텍스트 -->
        <Style x:Key="SettingsSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OverlayHintTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <!-- 설정 행: 아래 1px 구분선 -->
        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,7"/>
        </Style>

        <!-- 행 왼쪽 라벨 -->
        <Style x:Key="SettingsRowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OverlayInfoTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 행 라벨 아래 설명 -->
        <Style x:Key="SettingsRowHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OverlayHintTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 행 오른쪽 입력칸 -->
        <Style x:Key="SettingsRowInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputFieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputFieldBorderBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" Background="Transparent" BorderThickness="0" Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 내비게이션 (컴팩트 모드에서는 숨김) -->
            <Border x:Name="NavColumn"
                    Grid.Column="0"
                    Background="{DynamicResource InputFieldBackgroundBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,1,0"
                    MinWidth="110">
                <StackPanel Margin="0,4">
                    <TextBlock Text="기본" Style="{StaticResource SettingsNavGroupLabelStyle}"/>
                    <RadioButton x:Name="NavChat" Content="채팅" GroupName="SettingsNav" IsChecked="True" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavShout" Content="외치기" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavDisplay" Content="화면" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>

                    <TextBlock Text="추가 기능" Style="{StaticResource SettingsNavGroupLabelStyle}"/>
                    <RadioButton x:Name="NavAddonKeyword" Content="키워드 알림" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavAddonExp" Content="경험치 추적" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavAddonDungeon" Content="던전 도우미" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavAddonItem" Content="아이템 알림" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavAddonBuff" Content="버프 추적" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavAddonBoss" Content="필드 보스" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>

                    <TextBlock Text="관리" Style="{StaticResource SettingsNavGroupLabelStyle}"/>
                    <RadioButton x:Name="NavHotkeys" Content="단축키" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavSystem" Content="시스템" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                </StackPanel>
            </Border>

            <!-- 추가 기능(임베드): 자체 스크롤을 가지므로 설정 스크롤 밖에 배치 -->
            <views:AddonView x:Name="AddonHost" Grid.Column="1" Visibility="Collapsed"/>

            <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource OverlayScrollViewerStyle}">
                <!-- 폭 제한: 라벨-컨트롤 간격이 벌어지지 않도록 콘텐츠를 460~620px 범위로 유지 -->
                <StackPanel Margin="16,4,16,12" MinWidth="460" MaxWidth="620" HorizontalAlignment="Left">

                    <!-- ===================== 채팅 ===================== -->
                    <StackPanel x:Name="ChatPanel">
                        <TextBlock Text="채팅 필터" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,4,0,6"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding NormalColor}" Command="{Binding ColorPickCommand}" CommandParameter="Normal" Style="{StaticResource ColorPickerButtonStyle}"/>
                                    <CheckBox IsChecked="{Binding ShowNormal}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                </StackPanel>
                                <TextBlock Text="일반" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding TeamColor}" Command="{Binding ColorPickCommand}" CommandParameter="Team" Style="{StaticResource ColorPickerButtonStyle}"/>
                                    <CheckBox IsChecked="{Binding ShowTeam}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                </StackPanel>
                                <TextBlock Text="팀" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding ClubColor}" Command="{Binding ColorPickCommand}" CommandParameter="Club" Style="{StaticResource ColorPickerButtonStyle}"/>
                                    <CheckBox IsChecked="{Binding ShowClub}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                </StackPanel>
                                <TextBlock Text="클럽" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding ShoutColor}" Command="{Binding ColorPickCommand}" CommandParameter="Shout" Style="{StaticResource ColorPickerButtonStyle}"/>
                                    <CheckBox IsChecked="{Binding ShowShout}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                </StackPanel>
                                <TextBlock Text="외치기" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding SystemColor}" Command="{Binding ColorPickCommand}" CommandParameter="System" Style="{StaticResource ColorPickerButtonStyle}"/>
                                    <CheckBox IsChecked="{Binding ShowSystem}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                </StackPanel>
                                <TextBlock Text="시스템" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="아이디 표시" Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowEtaLevel}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                <TextBlock Text="에타 레벨" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowEtaCharacter}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                <TextBlock Text="캐릭터" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowIdTag}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="아이디 태그" Style="{StaticResource SettingsRowLabelStyle}"/>
                                        <Button Click="OpenIdTagFile_Click" ToolTip="idtag.txt 편집" Cursor="Hand" Margin="8,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock x:Name="Txt" Text="편집" FontSize="11" Foreground="{DynamicResource OverlaySubtleTextBrush}" TextDecorations="Underline"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource OverlayAccentTextBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="idtag.txt의 메모를 아이디 뒤에 [태그]로 표시" Style="{StaticResource SettingsRowHintStyle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowClubBoss}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                <TextBlock Text="클럽 보스" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowTimestamp}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                <TextBlock Text="타임 스탬프" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="폰트" Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton x:Name="NanumFontOption" Content="나눔고딕" Tag="나눔고딕" GroupName="FontFamilyOptions" Width="72" Height="26" Margin="0,0,4,0" Checked="FontOption_Checked" Style="{StaticResource FontOptionButtonStyle}"/>
                                    <RadioButton x:Name="GulimFontOption" Content="굴림" Tag="굴림" GroupName="FontFamilyOptions" Width="52" Height="26" Margin="0,0,4,0" Checked="FontOption_Checked" Style="{StaticResource FontOptionButtonStyle}"/>
                                    <RadioButton x:Name="CustomFontOption" Content="사용자 설정" Tag="사용자 설정" GroupName="FontFamilyOptions" Width="82" Height="26" Checked="FontOption_Checked" Style="{StaticResource FontOptionButtonStyle}"/>
                                </StackPanel>
                                <TextBlock Text="종류" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="220">
                                    <Slider Minimum="10" Maximum="40" Value="{Binding FontSize}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Width="180"/>
                                    <TextBlock Text="{Binding FontSize, StringFormat={}{0:F0}}" Foreground="{DynamicResource TextBrush}" Width="30" TextAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="크기" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== 외치기 ===================== -->
                    <StackPanel x:Name="ShoutPanel" Visibility="Collapsed">
                        <TextBlock Text="외치기 알림" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,4,0,6"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowShoutToastPopup}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="외치기 팝업" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="외치기 로그가 들어오면 토스트 팝업 표시" Style="{StaticResource SettingsRowHintStyle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AutoCopyShoutNickname}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="닉네임 자동복사" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="외치기 끝의 [닉네임]을 클립보드에 복사" Style="{StaticResource SettingsRowHintStyle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding ShoutToastDurationSeconds, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsRowInputStyle}" PreviewTextInput="NumberOnly_PreviewTextInput" KeyDown="OffsetInput_KeyDown"/>
                                <TextBlock Text="유지 시간(초)" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="220">
                                    <Slider Minimum="10" Maximum="40" Value="{Binding ShoutToastFontSize}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Width="180"/>
                                    <TextBlock Text="{Binding ShoutToastFontSize, StringFormat={}{0:F0}}" Foreground="{DynamicResource TextBrush}" Width="30" TextAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="토스트 글자 크기" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== 화면 ===================== -->
                    <StackPanel x:Name="DisplayPanel" Visibility="Collapsed">
                        <TextBlock Text="오버레이" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,4,0,6"/>
                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="220">
                                    <Slider Minimum="20" Maximum="100" Value="{Binding OverlayOpacityPercent, Mode=TwoWay, FallbackValue=96}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Width="180"/>
                                    <TextBlock Text="{Binding OverlayOpacityPercent, StringFormat={}{0:F0}%}" Foreground="{DynamicResource TextBrush}" Width="34" TextAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="투명도" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="글자는 항상 선명하게 유지됩니다" Style="{StaticResource SettingsRowHintStyle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="채팅창 위치" Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton Content="1" IsChecked="{Binding SelectedPresetNumber, Converter={StaticResource EqualValueToBoolConverter}, ConverterParameter=1}" Width="44" Style="{StaticResource PresetRadioButtonStyle}"/>
                                    <RadioButton Content="2" IsChecked="{Binding SelectedPresetNumber, Converter={StaticResource EqualValueToBoolConverter}, ConverterParameter=2}" Width="44" Style="{StaticResource PresetRadioButtonStyle}"/>
                                    <RadioButton Content="3" IsChecked="{Binding SelectedPresetNumber, Converter={StaticResource EqualValueToBoolConverter}, ConverterParameter=3}" Width="44" Style="{StaticResource PresetRadioButtonStyle}"/>
                                </StackPanel>
                                <TextBlock Text="프리셋" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="저장" Width="70" Height="26" Padding="0" Margin="0,0,6,0" Command="{Binding SaveOrLoadPresetCommand}" CommandParameter="Save" Style="{StaticResource SecondaryButtonStyle}" FontSize="12"/>
                                    <Button Content="불러오기" Width="70" Height="26" Padding="0" Command="{Binding SaveOrLoadPresetCommand}" CommandParameter="Load" Style="{StaticResource SecondaryButtonStyle}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="프리셋 저장/불러오기" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Width="90" Text="{Binding LineMarginLeft, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsRowInputStyle}" PreviewTextInput="NumberOnly_PreviewTextInput" KeyDown="OffsetInput_KeyDown"/>
                                <TextBlock Text="X 좌표 (좌우)" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Width="90" Text="{Binding LineMargin, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsRowInputStyle}" PreviewTextInput="NumberOnly_PreviewTextInput" KeyDown="OffsetInput_KeyDown"/>
                                <TextBlock Text="Y 좌표 (상하)" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== 단축키 ===================== -->
                    <StackPanel x:Name="HotkeyPanel" Visibility="Collapsed">
                        <TextBlock Text="전역 단축키" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,4,0,2"/>
                        <TextBlock Text="칸을 클릭한 뒤 원하는 키 조합을 누르세요. Esc 또는 Delete로 해제합니다." Style="{StaticResource SettingsRowHintStyle}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Text="{Binding ToggleOverlayHotKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsRowInputStyle}" PreviewKeyDown="HotKeyInput_PreviewKeyDown" PreviewMouseLeftButtonDown="HotKeyTextBox_PreviewMouseLeftButtonDown" IsReadOnly="True" Tag="HotKey"/>
                                <TextBlock Text="채팅창 ON/OFF" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Text="{Binding ToggleDailyWeeklyContentHotKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsRowInputStyle}" PreviewKeyDown="HotKeyInput_PreviewKeyDown" PreviewMouseLeftButtonDown="HotKeyTextBox_PreviewMouseLeftButtonDown" IsReadOnly="True" Tag="HotKey"/>
                                <TextBlock Text="일일/주간 콘텐츠 ON/OFF" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Text="{Binding ToggleSettingsHotKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsRowInputStyle}" PreviewKeyDown="HotKeyInput_PreviewKeyDown" PreviewMouseLeftButtonDown="HotKeyTextBox_PreviewMouseLeftButtonDown" IsReadOnly="True" Tag="HotKey"/>
                                <TextBlock Text="설정창 ON/OFF" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Text="{Binding ToggleTrayAllHotKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsRowInputStyle}" PreviewKeyDown="HotKeyInput_PreviewKeyDown" PreviewMouseLeftButtonDown="HotKeyTextBox_PreviewMouseLeftButtonDown" IsReadOnly="True" Tag="HotKey"/>
                                <TextBlock Text="모든 창 트레이 ON/OFF" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Text="{Binding ExitHotKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsRowInputStyle}" PreviewKeyDown="HotKeyInput_PreviewKeyDown" PreviewMouseLeftButtonDown="HotKeyTextBox_PreviewMouseLeftButtonDown" IsReadOnly="True" Tag="HotKey"/>
                                <TextBlock Text="프로그램 종료" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== 시스템 ===================== -->
                    <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
                        <TextBlock Text="로그" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,4,0,6"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Width="240" Text="{Binding ChatLogFolderPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsRowInputStyle}" TextAlignment="Left" Padding="5,0"/>
                                <TextBlock Text="채팅 로그 폴더" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="DebugOptionsBorder" Style="{StaticResource SettingsRowStyle}" Visibility="Collapsed">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EnableDebugLogging}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Debug.log 활성화" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="디버그 로그를 Debug.log 파일에 기록" Style="{StaticResource SettingsRowHintStyle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="유지 관리" Style="{StaticResource SettingsSectionLabelStyle}"/>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="실행" Width="70" Height="26" Padding="0" Command="{Binding ManualUpdateCommand}" Style="{StaticResource SecondaryButtonStyle}" FontSize="12"/>
                                <TextBlock Text="수동 업데이트" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="실행" Width="70" Height="26" Padding="0" Command="{Binding ManualLogReloadCommand}" Style="{StaticResource SecondaryButtonStyle}" FontSize="12"/>
                                <TextBlock Text="로그 다시 읽기" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="초기화" Width="70" Height="26" Padding="0" Command="{Binding InitSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" FontSize="12"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="설정 초기화" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock Text="모든 설정을 기본값으로 되돌립니다" Style="{StaticResource SettingsRowHintStyle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="종료" Width="70" Height="26" Padding="0" Command="{Binding ExitAppCommand}" Style="{StaticResource DangerButtonStyle}" FontSize="12"/>
                                <TextBlock Text="프로그램 종료" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
