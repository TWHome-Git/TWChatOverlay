                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ===================== 추가 기능: 필드 보스 ===================== -->
                    <StackPanel x:Name="AddonBossPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsTabStripStyle}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="필드 보스 알림" IsChecked="True" GroupName="BossTabs" IsHitTestVisible="False" Style="{StaticResource SettingsTabStyle}"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding BossAlarmCards}" Width="606" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,10,10"
                                            Background="{DynamicResource OverlayCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource OverlayStrongBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ScheduleText}" Foreground="{DynamicResource OverlayHintTextBrush}" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="3분 전" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding Alert3MinutesBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="1분 전" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding Alert1MinuteBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="5초 전" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding AlertAtSpawn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Slider Width="120" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Tag="Arkan.wav" ValueChanged="PreviewSoundSlider_ValueChanged"
                                            Value="{Binding BossAlertVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="{Binding BossAlertVolumePercent, StringFormat={}{0:F0}%}" Foreground="{DynamicResource TextBrush}" Width="34" TextAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="알림 볼륨" Style="{StaticResource SettingsRowLabelStyle}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
