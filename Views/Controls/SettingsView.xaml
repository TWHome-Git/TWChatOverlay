<UserControl x:Class="TWChatOverlay.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- 왼쪽 내비게이션 항목: 선택 시 왼쪽 2px 민트 라인 + 밝은 텍스트 -->
        <Style x:Key="SettingsNavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource OverlaySubtleTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2,0,0,0"
                                Padding="22,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayTabHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 내비게이션 그룹 라벨: 상위 구분 제목이므로 항목보다 크고 굵게 -->
        <Style x:Key="SettingsNavGroupLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="14,14,0,6"/>
        </Style>

        <!-- 섹션 라벨: 작은 회색 구분 텍스트 -->
        <Style x:Key="SettingsSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OverlayHintTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <!-- 설정 행(2열 배치, 절반 폭): 아래 1px 구분선 -->
        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,7"/>
            <Setter Property="Width" Value="272"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <!-- 전체 폭 행 -->
        <Style x:Key="SettingsRowWideStyle" TargetType="Border" BasedOn="{StaticResource SettingsRowStyle}">
            <Setter Property="Width" Value="558"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- 색상 동기화 링크형 체크: 켜짐=민트 동기화, 꺼짐=회색 -->
        <Style x:Key="SyncLinkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="ToolTip" Value="색상 동기화 — 켜면 줄 색을 따르고, 끄면 색 버튼으로 직접 지정"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <TextBlock x:Name="Txt" Text="동기화" FontSize="11" Foreground="{DynamicResource OverlaySubtleTextBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource OverlayAccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 행 왼쪽 라벨 -->
        <Style x:Key="SettingsRowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OverlayInfoTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 행 라벨 아래 설명 -->
        <Style x:Key="SettingsRowHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OverlayHintTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 행 오른쪽 입력칸 -->
        <Style x:Key="SettingsRowInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputFieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputFieldBorderBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- 작은 보조 버튼 -->
        <Style x:Key="DropFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="34"/>
        </Style>

        <!-- 도움말 [?] 버튼: Tag에 도움말 키를 지정, Help_Click에서 HelpWindow 표시 -->
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="설명 보기"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource OverlayHintTextBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock x:Name="Glyph"
                                       Text="?"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource OverlayHintTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OverlayAccentTextBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource OverlayAccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 도구 버튼(사이드바 최상단): 즉시 실행 항목 — 테두리 있는 버튼 칩 (EllesmereUI 참고) -->
        <Style x:Key="SettingsNavActionStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OverlayInfoTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource OverlayCardBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="8,2"
                                Padding="10,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayTabHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 도구 라디오(프로필 및 프리셋): 버튼 칩과 같은 형태 + 선택 상태 -->
        <Style x:Key="SettingsNavToolRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource OverlayInfoTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource OverlayCardBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="8,2"
                                Padding="10,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayTabHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 패널 상단 섹션 탭 (EllesmereUI 스타일: 선택 시 민트 밑줄) -->
        <Style x:Key="SettingsTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource OverlaySubtleTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="12,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 탭 스트립 컨테이너: 아래 구분선 -->
        <Style x:Key="SettingsTabStripStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin" Value="0,8,0,12"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" Background="Transparent" BorderThickness="0" Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 도구: 사이드바 최상단 버튼 그룹 (EllesmereUI 스타일) -->
            <Border x:Name="NavToolsColumn"
                    Grid.Row="0" Grid.Column="0"
                    Background="{DynamicResource InputFieldBackgroundBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,1,0"
                    Width="168">
                <StackPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource SettingsNavActionStyle}" Click="UnlockMode_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="잠금 해제 모드" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavActionStyle}" Click="NavWizard_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="설정 마법사" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavActionStyle}" Click="NavPatchNotes_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="패치 노트" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <RadioButton x:Name="NavPresets" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavToolRadioStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="프로필 및 프리셋" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="8,8,8,0"/>
                </StackPanel>
            </Border>

            <!-- 도구 오른쪽: 프로그램 아이콘 + 이름 (본문은 아래 행에서 시작) -->
            <Border x:Name="AppHeader" Grid.Row="0" Grid.Column="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="48,10,0,10">
                    <Border CornerRadius="4" ClipToBounds="True">
                        <Image Source="/TWChatOverlay;component/favicon.ico" Width="128" Height="128" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock Text="테일즈 채팅 오버레이" Foreground="{DynamicResource TextBrush}" FontSize="36" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="28,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- 왼쪽 내비게이션 (컴팩트 모드에서는 숨김) -->
            <Border x:Name="NavColumn"
                    Grid.Row="1" Grid.Column="0"
                    Background="{DynamicResource InputFieldBackgroundBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,1,0"
                    Width="168">
                <StackPanel Margin="0,4">
                    <TextBlock Text="기본" Style="{StaticResource SettingsNavGroupLabelStyle}"/>
                    <RadioButton x:Name="NavChat" Content="채팅" GroupName="SettingsNav" IsChecked="True" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavShout" Content="외치기" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavDisplay" Content="화면" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>

                    <TextBlock Text="추가 기능" Style="{StaticResource SettingsNavGroupLabelStyle}"/>
                    <RadioButton x:Name="NavAddonKeyword" Content="키워드 알림" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavAddonExp" Content="경험치 추적" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavAddonDungeon" Content="던전 도우미" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavAddonItem" Content="아이템 알림" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavAddonBuff" Content="버프 추적" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavAddonBoss" Content="필드 보스" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>

                    <TextBlock Text="관리" Style="{StaticResource SettingsNavGroupLabelStyle}"/>
                    <RadioButton x:Name="NavHotkeys" Content="단축키" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                    <RadioButton x:Name="NavSystem" Content="시스템" GroupName="SettingsNav" Checked="Nav_Checked" Style="{StaticResource SettingsNavItemStyle}"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource OverlayScrollViewerStyle}">
                <StackPanel Margin="16,4,12,12" Width="566" HorizontalAlignment="Left">

                    <!-- ===================== 채팅 ===================== -->
                    <StackPanel x:Name="ChatPanel">
                        <Border Style="{StaticResource SettingsTabStripStyle}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ChatTabFilter" Content="채팅 필터" IsChecked="True" GroupName="ChatTabs" Style="{StaticResource SettingsTabStyle}"/>
                                <RadioButton x:Name="ChatTabId" Content="아이디 표시" GroupName="ChatTabs" Style="{StaticResource SettingsTabStyle}"/>
                                <RadioButton x:Name="ChatTabFont" Content="폰트" GroupName="ChatTabs" Style="{StaticResource SettingsTabStyle}"/>
                                <RadioButton x:Name="ChatTabClone1" Content="서브 채팅창 1" GroupName="ChatTabs" Style="{StaticResource SettingsTabStyle}"/>
                                <RadioButton x:Name="ChatTabClone2" Content="서브 채팅창 2" GroupName="ChatTabs" Style="{StaticResource SettingsTabStyle}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding IsChecked, ElementName=ChatTabFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="기본 채팅 필터" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0"/>
                            <Button Style="{StaticResource HelpButtonStyle}" Tag="chat.filter" Click="Help_Click"/>
                        </StackPanel>
                        <WrapPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding NormalColor}" Command="{Binding ColorPickCommand}" CommandParameter="Normal" Style="{StaticResource ColorPickerButtonStyle}"/>
                                        <CheckBox IsChecked="{Binding ShowNormal}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="일반" Style="{StaticResource SettingsRowLabelStyle}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding TeamColor}" Command="{Binding ColorPickCommand}" CommandParameter="Team" Style="{StaticResource ColorPickerButtonStyle}"/>
                                        <CheckBox IsChecked="{Binding ShowTeam}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="팀" Style="{StaticResource SettingsRowLabelStyle}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding ClubColor}" Command="{Binding ColorPickCommand}" CommandParameter="Club" Style="{StaticResource ColorPickerButtonStyle}"/>
                                        <CheckBox IsChecked="{Binding ShowClub}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="클럽" Style="{StaticResource SettingsRowLabelStyle}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding ShoutColor}" Command="{Binding ColorPickCommand}" CommandParameter="Shout" Style="{StaticResource ColorPickerButtonStyle}"/>
                                        <CheckBox IsChecked="{Binding ShowShout}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="외치기" Style="{StaticResource SettingsRowLabelStyle}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding SystemColor}" Command="{Binding ColorPickCommand}" CommandParameter="System" Style="{StaticResource ColorPickerButtonStyle}"/>
                                        <CheckBox IsChecked="{Binding ShowSystem}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="시스템" Style="{StaticResource SettingsRowLabelStyle}"/>
                                </DockPanel>
                            </Border>
                        </WrapPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsChecked, ElementName=ChatTabId, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="아이디 표시" Style="{StaticResource SettingsSectionLabelStyle}" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource SyncLinkCheckBoxStyle}" IsChecked="{Binding SenderIdColorSync}"/>
                                        <Button Width="26" Height="14" Margin="0,0,62,0" Background="{Binding SenderIdColor}" IsEnabled="{Binding SenderIdColorEditable}" Command="{Binding ColorPickCommand}" CommandParameter="SenderId" Style="{StaticResource ColorPickerButtonStyle}" ToolTip="동기화를 끄면 지정할 수 있습니다"/>
                                    </StackPanel>
                                    <TextBlock Text="아이디" Style="{StaticResource SettingsRowLabelStyle}" ToolTip="채팅 줄의 보낸 사람 아이디 색상"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource SyncLinkCheckBoxStyle}" IsChecked="{Binding EtaLevelColorSync}"/>
                                        <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding EtaLevelColor}" IsEnabled="{Binding EtaLevelColorEditable}" Command="{Binding ColorPickCommand}" CommandParameter="EtaLevel" Style="{StaticResource ColorPickerButtonStyle}" ToolTip="동기화를 끄면 지정할 수 있습니다"/>
                                        <CheckBox IsChecked="{Binding ShowEtaLevel}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="에타 레벨" Style="{StaticResource SettingsRowLabelStyle}"/>
                                        <Button Style="{StaticResource HelpButtonStyle}" Tag="chat.id.eta_level" Click="Help_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource SyncLinkCheckBoxStyle}" IsChecked="{Binding EtaCharacterColorSync}"/>
                                        <Button Width="26" Height="14" Margin="0,0,10,0" Background="{Binding EtaCharacterColor}" IsEnabled="{Binding EtaCharacterColorEditable}" Command="{Binding ColorPickCommand}" CommandParameter="EtaCharacter" Style="{StaticResource ColorPickerButtonStyle}" ToolTip="동기화를 끄면 지정할 수 있습니다"/>
                                        <CheckBox IsChecked="{Binding ShowEtaCharacter}" Style="{StaticResource ToggleSwitchCheckBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="캐릭터" Style="{StaticResource SettingsRowLabelStyle}"/>
