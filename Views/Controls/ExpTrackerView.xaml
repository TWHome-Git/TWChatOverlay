<UserControl x:Class="TWChatOverlay.Views.ExpTrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="28" d:DesignWidth="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource OverlayPanelBackgroundBrush}"
            CornerRadius="6"
            BorderBrush="{DynamicResource OverlayPanelBorderBrush}"
            BorderThickness="1"
            Padding="12,5"
            Height="66">
        <DockPanel LastChildFill="True" VerticalAlignment="Center">
            <Button DockPanel.Dock="Right"
                    Foreground="{DynamicResource FieldLabelTextBrush}"
                    FontSize="18"
                    Margin="6,-10,0,0"
                    Width="22"
                    Height="22"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Command="{Binding ResetExpCommand}"
                    Background="Transparent"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="x">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="0,0,0,2"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalExpDisplay}"
                           Foreground="{DynamicResource OverlayRareAccentBrush}"
                           FontSize="21"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastGainedExpDisplay}"
                           Foreground="{DynamicResource OverlaySuccessAccentBrush}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="10,1,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasLastExp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding GainCountDisplay}"
                           Foreground="{DynamicResource OverlayExpAccentBrush}"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding ShowGainCountDisplay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
