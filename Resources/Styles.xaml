<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TWChatOverlay.Converters"
                    xmlns:services="clr-namespace:TWChatOverlay.Services">

    <!-- Converters -->
    <local:EqualValueToBoolConverter x:Key="EqualValueToBoolConverter"/>
    <local:BooleanInverseConverter x:Key="BooleanInverseConverter"/>
    <services:VisibilityConverter x:Key="VisibilityConverter"/>

    <!-- Color Definitions -->
    <Color x:Key="PrimaryBackgroundColor">#131917</Color>
    <Color x:Key="SecondaryBackgroundColor">#161D1A</Color>
    <Color x:Key="BorderColor">#FF2A332E</Color>
    <Color x:Key="TextColor">#E8EAE9</Color>
    <Color x:Key="AccentColor">#0CD29D</Color>
    <Color x:Key="SuccessColor">#2FBF71</Color>
    <Color x:Key="WarningColor">#E05252</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <!-- Switchable overlay palette -->
    <SolidColorBrush x:Key="OverlayWindowBackgroundBrush" Color="#F0121816"/>
    <SolidColorBrush x:Key="OverlayWindowBorderBrush" Color="#FF2A332E"/>
    <SolidColorBrush x:Key="OverlayHeaderBackgroundBrush" Color="#FF19211D"/>
    <SolidColorBrush x:Key="OverlayDragBarBackgroundBrush" Color="#FF141B18"/>
    <SolidColorBrush x:Key="OverlayDragBarTextBrush" Color="#FF8C9197"/>
    <SolidColorBrush x:Key="OverlayTabHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="OverlayTabSelectedBrush" Color="#1F0CD29D"/>
    <SolidColorBrush x:Key="OverlayTabSelectedBorderBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="OverlayPanelBackgroundBrush" Color="#EE101614"/>
    <SolidColorBrush x:Key="OverlayPanelBorderBrush" Color="#FF232B27"/>
    <SolidColorBrush x:Key="OverlayBuffTileBackgroundBrush" Color="#CC0D1210"/>
    <SolidColorBrush x:Key="OverlayBuffTileBorderBrush" Color="#FF2A332E"/>
    <SolidColorBrush x:Key="OverlayHelperWindowBorderBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="OverlayMutedTextBrush" Color="#FF8C9197"/>
    <SolidColorBrush x:Key="OverlayHintTextBrush" Color="#FF77807B"/>
    <SolidColorBrush x:Key="OverlayLabelTextBrush" Color="#FFC7CCC9"/>
    <SolidColorBrush x:Key="OverlayRareAccentBrush" Color="#FFD8B45A"/>
    <SolidColorBrush x:Key="OverlayExpAccentBrush" Color="#FF5AC8E8"/>
    <SolidColorBrush x:Key="OverlayScrollThumbBrush" Color="#FF232B27"/>
    <SolidColorBrush x:Key="OverlayScrollThumbHoverBrush" Color="#FF2E3833"/>
    <SolidColorBrush x:Key="OverlayScrollThumbActiveBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="OverlayScrollButtonBackgroundBrush" Color="#FF0AA97F"/>
    <SolidColorBrush x:Key="OverlayScrollButtonHoverBrush" Color="#FF0CBF8F"/>
    <SolidColorBrush x:Key="OverlayScrollButtonBorderBrush" Color="#FF086F55"/>
    <SolidColorBrush x:Key="OverlayShellBackgroundBrush" Color="#FF101614"/>
    <SolidColorBrush x:Key="OverlaySurfaceBackgroundBrush" Color="#FF101614"/>
    <SolidColorBrush x:Key="OverlaySurfaceAltBackgroundBrush" Color="#FF1A2320"/>
    <SolidColorBrush x:Key="OverlayCardBackgroundBrush" Color="#FF161D1A"/>
    <SolidColorBrush x:Key="OverlayStrongBorderBrush" Color="#FF232B27"/>
    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#FF232B27"/>
    <SolidColorBrush x:Key="OverlayTitleAccentTextBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="OverlaySubtleTextBrush" Color="#FF8C9197"/>
    <SolidColorBrush x:Key="OverlayInfoTextBrush" Color="#FFD4D8D6"/>
    <SolidColorBrush x:Key="OverlayHighlightBackgroundBrush" Color="#140CD29D"/>
    <SolidColorBrush x:Key="OverlayAccentBorderBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="OverlayWarningBorderBrush" Color="#FFF5A623"/>
    <SolidColorBrush x:Key="OverlaySuccessAccentBrush" Color="#FF2FBF71"/>
    <SolidColorBrush x:Key="OverlayDangerBackgroundBrush" Color="#FF181010"/>
    <SolidColorBrush x:Key="OverlayDangerBorderBrush" Color="#FFB03A3A"/>
    <SolidColorBrush x:Key="OverlayDangerAccentBrush" Color="#FFE05252"/>
    <SolidColorBrush x:Key="OverlayLoadingAccentBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="OverlayShoutBorderBrush" Color="#E0FFB347"/>
    <SolidColorBrush x:Key="OverlayShoutFillBrush" Color="#FFB347"/>
    <SolidColorBrush x:Key="OverlayShoutTextBrush" Color="#FFD39A"/>
    <SolidColorBrush x:Key="OverlayLoadingMaskBrush" Color="#AA0E1412"/>
    <SolidColorBrush x:Key="MenuButtonHoverBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="MenuButtonPressedBrush" Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="OverlayAccentTextBrush" Color="#FF0CD29D"/>

    <!-- Control brushes -->
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFE8EAE9"/>
    <SolidColorBrush x:Key="SectionHeaderTextBrush" Color="#FFE8EAE9"/>
    <SolidColorBrush x:Key="SubsectionHeaderTextBrush" Color="#FF8C9197"/>
    <SolidColorBrush x:Key="InfoLabelTextBrush" Color="#FF8C9197"/>
    <SolidColorBrush x:Key="FieldLabelTextBrush" Color="#FF8C9197"/>
    <SolidColorBrush x:Key="InputFieldBackgroundBrush" Color="#FF0D1210"/>
    <SolidColorBrush x:Key="InputFieldBorderBrush" Color="#FF2A332E"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FF1E2622"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF2E3833"/>
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="TabSelectedAccentBackgroundBrush" Color="#1F0CD29D"/>
    <SolidColorBrush x:Key="TabSelectedAccentBorderBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="TabHoverBorderBrush" Color="#FF2E3833"/>
    <SolidColorBrush x:Key="PresetCheckedBackgroundBrush" Color="#330CD29D"/>
    <SolidColorBrush x:Key="PresetCheckedBorderBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="PresetSaveButtonBrush" Color="#FF1A2320"/>
    <SolidColorBrush x:Key="PresetLoadButtonBrush" Color="#260CD29D"/>
    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#59E05252"/>
    <SolidColorBrush x:Key="CloseButtonBackgroundBrush" Color="#59E05252"/>
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#8CE05252"/>
    <SolidColorBrush x:Key="CloseButtonPressedBrush" Color="#B3B03A3A"/>
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#FF2A332E"/>
    <SolidColorBrush x:Key="ToggleTrackBorderBrush" Color="#FF3A4640"/>
    <SolidColorBrush x:Key="ToggleTrackHoverBorderBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="ToggleTrackOnBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="ToggleTrackOnBorderBrush" Color="#FF0AA97F"/>
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFE8EAE9"/>
    <SolidColorBrush x:Key="ComboFieldBackgroundBrush" Color="#FF0D1210"/>
    <SolidColorBrush x:Key="ComboFieldBorderBrush" Color="#FF2A332E"/>
    <SolidColorBrush x:Key="ComboFieldHoverBorderBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="ComboFieldOpenBorderBrush" Color="#FF0AA97F"/>
    <SolidColorBrush x:Key="ComboFieldTextBrush" Color="#FFE8EAE9"/>
    <SolidColorBrush x:Key="ComboPopupBackgroundBrush" Color="#FF121815"/>
    <SolidColorBrush x:Key="ComboItemTextBrush" Color="#FFD4D8D6"/>
    <SolidColorBrush x:Key="ComboItemHoverBrush" Color="#FF1E2622"/>
    <SolidColorBrush x:Key="ComboItemSelectedBrush" Color="#330CD29D"/>
    <SolidColorBrush x:Key="PresetButtonBackgroundBrush" Color="#FF161D1A"/>
    <SolidColorBrush x:Key="PresetButtonHoverBrush" Color="#FF1E2622"/>
    <SolidColorBrush x:Key="PresetButtonPressedBrush" Color="#FF0AA97F"/>
    <SolidColorBrush x:Key="PresetButtonTextBrush" Color="#FFD4D8D6"/>
    <SolidColorBrush x:Key="PresetButtonBorderBrush" Color="#FF2A332E"/>
    <SolidColorBrush x:Key="SimButtonBackgroundBrush" Color="#FF0E8F6C"/>
    <SolidColorBrush x:Key="SimButtonBorderBrush" Color="#FF0AA97F"/>
    <SolidColorBrush x:Key="SimButtonHoverBrush" Color="#FF12A67E"/>
    <SolidColorBrush x:Key="SimButtonPressedBrush" Color="#FF0B7A5D"/>
    <SolidColorBrush x:Key="SimInputBackgroundBrush" Color="#FF0D1210"/>
    <SolidColorBrush x:Key="SimInputTextBrush" Color="#FFE8EAE9"/>

    <!-- Converters (Legacy) -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- Tab Button Style: EUI식 — 활성 탭은 하단 2px 민트 밑줄 + 밝은 텍스트, 비활성은 회색 -->
    <Style x:Key="TabButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OverlaySubtleTextBrush}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="2,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                            BorderThickness="0,0,0,2"
                            BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource OverlayTabHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="2,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource OverlayTabHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Backwards-compatible keys: some XAML files reference these named styles (case-sensitive).
         Provide keyed styles that alias the implicit styles so older XAML keeps working. -->
    <Style x:Key="ChatScrollBarStyle" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"/>
    <Style x:Key="ChatScrollViewerStyle" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}"/>

    <!-- TabControl Style: no frame, no own background — the host window's single color shows through -->
    <Style TargetType="TabControl" x:Key="SettingsTabControlStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" Margin="0,0,0,6"/>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="8">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem" x:Key="SettingsTabItemStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OverlaySubtleTextBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="8,0,8,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedAccentBackgroundBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabSelectedAccentBorderBrush}"/>
                            <Setter TargetName="Bd" Property="Panel.ZIndex" Value="2"/>
                            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayTabHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChatScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="{DynamicResource OverlayScrollThumbBrush}" CornerRadius="3" Margin="2" SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource OverlayScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource OverlayScrollThumbActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit ScrollBar style for vertical scrollbars in the app (adopted from AddonWindow) -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsEnabled="{TemplateBinding IsEnabled}" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ChatScrollBarThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit ScrollViewer style (adopted from AddonWindow) -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button Style -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource OverlayTabHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Color Picker Button Style -->
    <Style x:Key="ColorPickerButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Danger Button Style -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Window Close Button Style: 고스트 아이콘 버튼 — 평소엔 회색 ✕, 호버 시 붉은 배경 + 흰 ✕.
         Content 값과 무관하게 통일된 ✕ 글리프를 그린다. -->
    <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="Transparent"
                            CornerRadius="3">
                        <TextBlock x:Name="Glyph"
                                   Text="&#x2715;"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource OverlayInfoTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource OverlayDangerAccentBrush}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource OverlayDangerBorderBrush}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset RadioButton Style -->
    <Style x:Key="PresetRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="RadioBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Padding="10,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioBorder" Property="Background" Value="{DynamicResource OverlayTabHoverBrush}"/>
                            <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioBorder" Property="Background" Value="{DynamicResource PresetCheckedBackgroundBrush}"/>
                            <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{DynamicResource PresetCheckedBorderBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section Header TextBlock Style -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderTextBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!-- Subsection Header TextBlock Style -->
    <Style x:Key="SubsectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SubsectionHeaderTextBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!-- Info TextBlock Style -->
    <Style x:Key="InfoTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InfoLabelTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,5,0,5"/>
    </Style>

    <!-- Hint TextBlock Style -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OverlayHintTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>

    <!-- Input TextBox Style -->
    <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource OverlaySurfaceBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayStrongBorderBrush}"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Settings Border Style: subtle bottom separator only, no bright frame -->
    <Style x:Key="SettingsBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="Padding" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="ToggleSwitchCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          Margin="0,0,14,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                        <Border x:Name="SwitchTrack"
                                Grid.Column="1"
                                Width="54"
                                Height="28"
                                Background="{DynamicResource ToggleTrackOffBrush}"
                                BorderBrush="{DynamicResource ToggleTrackBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid>
                                <Border x:Name="SwitchThumb"
                                        Width="22"
                                        Height="22"
                                        Margin="3,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ToggleThumbBrush}"
                                        CornerRadius="11"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ToggleTrackOnBrush}"/>
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ToggleTrackOnBorderBrush}"/>
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ToggleTrackHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.45"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ComboItemTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ComboPopupBackgroundBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboItemSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="ToggleBorder"
                Background="{DynamicResource ComboFieldBackgroundBrush}"
                BorderBrush="{DynamicResource ComboFieldBorderBrush}"
                BorderThickness="1"
                CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  Margin="8,0,4,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="1"
                           Text="▼"
                           Foreground="{DynamicResource ComboFieldTextBrush}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource ComboFieldHoverBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource ComboFieldOpenBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.6"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource ComboFieldTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ComboFieldBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ComboFieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press"
                                      Template="{StaticResource DarkComboBoxToggleButtonTemplate}">
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Slide"
                               StaysOpen="False"
                               Panel.ZIndex="10000">
                            <Border x:Name="PopupBorder"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource ComboPopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource ComboFieldBorderBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PopupBorder" Property="MinHeight" Value="24"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FontOptionButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ComboFieldTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ComboFieldBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ComboFieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ComboFieldHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ComboItemSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ComboItemTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Overlay Scroll Styles -->
    <Style TargetType="Thumb" x:Key="OverlayScrollBarThumbStyle">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="{DynamicResource OverlayScrollThumbBrush}" CornerRadius="4" Margin="2" SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource OverlayScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource OverlayScrollThumbActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" x:Key="OverlayScrollBarStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsEnabled="{TemplateBinding IsEnabled}" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource OverlayScrollBarThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Style="{StaticResource OverlayScrollBarStyle}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CategoryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OverlayInfoTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <!-- remove per-button padding; template provides consistent inner padding -->
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- outer border reserves highlight space and provides consistent padding -->
                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuButtonHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource OverlaySubtleTextBrush}"/>
        <Setter Property="Margin" Value="15,2,5,2"/>
    </Style>

    <!-- Missing styles used by IncSimulatorView -->
    <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Background" Value="{DynamicResource PresetButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PresetButtonTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PresetButtonBorderBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PresetButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PresetButtonPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SimButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="{DynamicResource SimButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SimButtonBorderBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SimButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SimButtonPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SimTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
        <Setter Property="Background" Value="{DynamicResource SimInputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SimInputTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PresetButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
