<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 API(Windows.Media.Ocr, 운명 선고 순서 글자 인식)를 쓰려고 Windows SDK 버전을 붙인다 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <CodePage>65001</CodePage>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>5.1.12</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <!-- 테스트 프로젝트(Tests\)는 같은 저장소에 있지만 앱 빌드에는 섞이지 않게 뺀다. 테스트는 앱의 internal 멤버를 볼 수 있다 -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TWChatOverlay.Tests" />
  </ItemGroup>

  <!-- 디버그 전용 코드는 Release 빌드에서 제외 (XAML은 #if를 못 쓰므로 빌드 조건으로) -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Page Remove="Views\Overlays\DebugLogTestWindow.xaml" />
    <Compile Remove="Views\Overlays\DebugLogTestWindow.xaml.cs" />
    <!-- 도움말 예시 이미지 생성기(render-help-shots 인수)는 개발용. App.xaml.cs의 호출도 #if DEBUG 안에 있어야 한다 -->
    <Compile Remove="Services\Diagnostics\HelpShotRenderer.cs" />
  </ItemGroup>

  <!-- Default None 항목에서 제외 (Resource로 재등록) -->
  <ItemGroup>
    <None Remove="Data\images\**\*" />
    <None Remove="Sound\*.mp3" />
  </ItemGroup>

  <!-- 이미지/사운드 리소스 (readme_*는 README 문서 전용 — exe에 임베드하지 않음) -->
  <ItemGroup>
    <Resource Include="Data\images\**\*" />
    <Resource Remove="Data\images\Help\readme_*.png" />
    <Resource Include="Sound\*.mp3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="favicon.ico" />
  </ItemGroup>

  <!-- 번들 폰트: 출력 폴더의 Font\ 에 파일로 복사되어 FontService가 로드한다 -->
  <ItemGroup>
    <None Include="Font\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 공장 기본 설정: 설정 초기화·최초 실행 시 로드되는 기본 프로필 -->
  <ItemGroup>
    <None Include="Defaults\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <!-- 단일 파일 실행본에는 런타임의 createdump.exe 가 빠진다 (런타임이 실행 파일에 합쳐질 때 같이 빠지는 파일 목록에 들어 있다).
       화면 멈춤 덤프(UiHangWatchdog)가 그 도구로 덤프를 쓰므로 묶음에 다시 넣는다 — 실행하면 다른 네이티브 파일과 같은 임시 폴더에 풀린다.
       폴더로 푸는 실행본 · 디버그 실행에는 원래 들어 있어 손대지 않는다. -->
  <Target Name="BundleCreateDumpForSingleFile" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">
    <ItemGroup>
      <_CreateDumpTool Include="@(ResolvedRuntimePack->'%(PackageDirectory)\runtimes\$(RuntimeIdentifier)\native\createdump.exe')" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <ResolvedFileToPublish Include="@(_CreateDumpTool)" Condition="Exists('%(_CreateDumpTool.FullPath)')" RelativePath="createdump.exe" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Warning Condition="'@(ResolvedFileToPublish->WithMetadataValue('RelativePath', 'createdump.exe'))' == ''" Text="createdump.exe 를 런타임 팩에서 찾지 못했습니다 — 이 실행본은 화면 멈춤 덤프를 남기지 못합니다." />
  </Target>

</Project>
