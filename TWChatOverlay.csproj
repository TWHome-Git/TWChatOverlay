<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <CodePage>65001</CodePage>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>5.1.10</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <!-- 디버그 전용 코드는 Release 빌드에서 제외 (XAML은 #if를 못 쓰므로 빌드 조건으로) -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Page Remove="Views\Overlays\DebugLogTestWindow.xaml" />
    <Compile Remove="Views\Overlays\DebugLogTestWindow.xaml.cs" />
    <!-- 도움말 예시 이미지 생성기(render-help-shots 인수)는 개발용. App.xaml.cs의 호출도 #if DEBUG 안에 있어야 한다 -->
    <Compile Remove="Services\Diagnostics\HelpShotRenderer.cs" />
  </ItemGroup>

  <!-- Default None 항목에서 제외 (Resource로 재등록) -->
  <ItemGroup>
    <None Remove="Data\images\**\*" />
    <None Remove="Sound\*.mp3" />
  </ItemGroup>

  <!-- 이미지/사운드 리소스 (readme_*는 README 문서 전용 — exe에 임베드하지 않음) -->
  <ItemGroup>
    <Resource Include="Data\images\**\*" />
    <Resource Remove="Data\images\Help\readme_*.png" />
    <Resource Include="Sound\*.mp3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="favicon.ico" />
  </ItemGroup>

  <!-- 번들 폰트: 출력 폴더의 Font\ 에 파일로 복사되어 FontService가 로드한다 -->
  <ItemGroup>
    <None Include="Font\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 공장 기본 설정: 설정 초기화·최초 실행 시 로드되는 기본 프로필 -->
  <ItemGroup>
    <None Include="Defaults\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>
